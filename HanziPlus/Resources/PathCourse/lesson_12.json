  "sections": [
    {
      "kind": "dialogue",
      "continueButtonTitle": "Дальше",
      "showLessonHeader": true,
      "dialogue": {
        "id": "dialogue_where_study",
        "title": "你在哪儿学习汉语",
        "lines": [
          {
            "speaker": "A",
            "hanzi": "你在哪儿学习汉语？",
            "pinyin": "Nǐ zài nǎr xuéxí Hànyǔ?",
            "translation": {
              "ru": "Где ты изучаешь китайский язык?",
              "en": "Where do you study Chinese?",
              "es": "¿Dónde estudias chino?",
              "pt-BR": "Onde você estuda chinês?"
            },
            "audioKey": null
          },
          {
            "speaker": "B",
            "hanzi": "在北京语言大学。",
            "pinyin": "Zài Běijīng Yǔyán Dàxué.",
            "translation": {
              "ru": "В Пекинском университете языка и культуры.",
              "en": "At Beijing Language and Culture University.",
              "es": "En la Universidad de Lenguas y Cultura de Pekín.",
              "pt-BR": "Na Universidade de Línguas e Cultura de Pequim."
            },
            "audioKey": null
          },
          {
            "speaker": "A",
            "hanzi": "你们的老师怎么样？",
            "pinyin": "Nǐmen de lǎoshī zěnmeyàng?",
            "translation": {
              "ru": "Как ваш преподаватель?",
              "en": "How is your teacher?",
              "es": "¿Cómo es vuestro profesor?",
              "pt-BR": "Como é o professor de vocês?"
            },
            "audioKey": null
          },
          {
            "speaker": "B",
            "hanzi": "很好！",
            "pinyin": "Hěn hǎo!",
            "translation": {
              "ru": "Очень хороший!",
              "en": "Very good!",
              "es": "¡Muy bien!",
              "pt-BR": "Muito bom!"
            },
            "audioKey": null
          },
          {
            "speaker": "A",
            "hanzi": "你觉得学习汉语难吗？",
            "pinyin": "Nǐ juéde xuéxí Hànyǔ nán ma?",
            "translation": {
              "ru": "Как ты думаешь, трудно ли изучать китайский язык?",
              "en": "Do you think studying Chinese is difficult?",
              "es": "¿Crees que estudiar chino es difícil?",
              "pt-BR": "Você acha que estudar chinês é difícil?"
            },
            "audioKey": null
          },
          {
            "speaker": "B",
            "hanzi": "我觉得语法不太难。听和说也比较容易，但是读和写很难。",
            "pinyin": "Wǒ juéde yǔfǎ bú tài nán. Tīng hé shuō yě bǐjiào róngyì, dànshì dú hé xiě hěn nán.",
            "translation": {
              "ru": "Я думаю, грамматика не очень трудная. Слушать и говорить тоже относительно легко, но читать и писать очень трудно.",
              "en": "I think grammar is not too difficult. Listening and speaking are also relatively easy, but reading and writing are very difficult.",
              "es": "Creo que la gramática no es muy difícil. Escuchar y hablar también son relativamente fáciles, pero leer y escribir son muy difíciles.",
              "pt-BR": "Acho que a gramática não é muito difícil. Ouvir e falar também são relativamente fáceis, mas ler e escrever são muito difíceis."
            },
            "audioKey": null
          }
        ]
      }
    },
    {
      "kind": "dialogue",
      "continueButtonTitle": "Изучить новые слова",
      "showLessonHeader": false,
      "dialogue": {
        "id": "dialogue_class",
        "title": "你们的老师是谁",
        "lines": [
          {
            "speaker": "A",
            "hanzi": "我给你们介绍一下儿，这位是新同学，是我的同屋。",
            "pinyin": "Wǒ gěi nǐmen jièshao yíxiàr, zhè wèi shì xīn tóngxué, shì wǒ de tóngwū.",
            "translation": {
              "ru": "Позвольте вам представить: это новый однокурсник, мой сосед по комнате.",
              "en": "Let me introduce you: this is a new classmate, my roommate.",
              "es": "Permítanme presentarles: este es un nuevo compañero de clase, mi compañero de cuarto.",
              "pt-BR": "Deixe-me apresentar: este é um novo colega de classe, meu colega de quarto."
            },
            "audioKey": null
          },
          {
            "speaker": "B",
            "hanzi": "你在哪个班学习？",
            "pinyin": "Nǐ zài nǎge bān xuéxí?",
            "translation": {
              "ru": "В каком классе ты учишься?",
              "en": "Which class do you study in?",
              "es": "¿En qué clase estudias?",
              "pt-BR": "Em qual turma você estuda?"
            },
            "audioKey": null
          },
          {
            "speaker": "C",
            "hanzi": "在103班。",
            "pinyin": "Zài yī líng sān bān.",
            "translation": {
              "ru": "В 103-м классе.",
              "en": "In Class 103.",
              "es": "En la clase 103.",
              "pt-BR": "Na turma 103."
            },
            "audioKey": null
          },
          {
            "speaker": "B",
            "hanzi": "你们的老师是谁？",
            "pinyin": "Nǐmen de lǎoshī shì shéi?",
            "translation": {
              "ru": "Кто ваш преподаватель?",
              "en": "Who is your teacher?",
              "es": "¿Quién es vuestro profesor?",
              "pt-BR": "Quem é o professor de vocês?"
            },
            "audioKey": null
          },
          {
            "speaker": "C",
            "hanzi": "我们的老师是林老师。",
            "pinyin": "Wǒmen de lǎoshī shì Lín lǎoshī.",
            "translation": {
              "ru": "Наш преподаватель — преподаватель Линь.",
              "en": "Our teacher is Teacher Lin.",
              "es": "Nuestro profesor es el profesor Lin.",
              "pt-BR": "Nosso professor é o professor Lin."
            },
            "audioKey": null
          }
        ]
      }
    },
