  "chapters": [
    {
      "id": "lesson_01_ch01",
      "number": 1,
      "title": {
        "ru": "Пиньинь и тоны",
        "en": "Pinyin and tones",
        "es": "Pinyin y tonos",
        "pt-BR": "Pinyin e tons"
      },
      "goal": {
        "ru": "Понять, как читать pinyin и различать четыре тона.",
        "en": "Understand how to read pinyin and distinguish the four tones.",
        "es": "Entender cómo leer pinyin y distinguir los cuatro tonos.",
        "pt-BR": "Entender como ler pinyin e distinguir os quatro tons."
      },
      "estimatedMinutes": 8,
      "toneGuide": {
        "id": "l01_tone_guide",
        "title": {
          "ru": "Как читать pinyin",
          "en": "How to read pinyin",
          "es": "Cómo leer pinyin",
          "pt-BR": "Como ler pinyin"
        },
        "introduction": {
          "ru": "Pinyin — латинская транскрипция китайского. Один и тот же слог с разными тонами может иметь разный смысл. В курсе мы учим тоны визуально: смотри на линию тона и знак над буквой.",
          "en": "Pinyin is the Latin transcription of Chinese. The same syllable with different tones can mean different things. In this course we learn tones visually: watch the tone contour and the mark above the vowel.",
          "es": "Pinyin es la transcripción latina del chino. El mismo sílabo con distintos tonos puede tener distintos significados. En este curso aprendemos los tonos visualmente: observa la línea del tono y la marca sobre la vocal.",
          "pt-BR": "Pinyin é a transcrição latina do chinês. O mesmo sílaba com tons diferentes pode ter significados diferentes. Neste curso aprendemos os tons visualmente: observe a linha do tono e a marca sobre a vocal."
        },
        "tones": [
          {
            "syllable": "ma1",
            "pinyin": "mā",
            "toneNumber": 1,
            "meaning": {
              "ru": "мама (妈)",
              "en": "mother (妈)",
              "es": "madre (妈)",
              "pt-BR": "mãe (妈)"
            },
            "contourDescription": {
              "ru": "Первый тон — высокий и ровный, как удерживаемая нота.",
              "en": "First tone — high and level, like a held note.",
              "es": "Primer tono — alto y plano, como una nota sostenida.",
              "pt-BR": "Primeiro tono — alto e plano, como uma nota sustentada."
            }
          },
          {
            "syllable": "ma2",
            "pinyin": "má",
            "toneNumber": 2,
            "meaning": {
              "ru": "пеньё (麻)",
              "en": "hemp (麻)",
              "es": "cáñamo (麻)",
              "pt-BR": "cânhamo (麻)"
            },
            "contourDescription": {
              "ru": "Второй тон — от среднего к высокому, как вопрос «что?».",
              "en": "Second tone — rises from mid to high, like asking “what?”",
              "es": "Segundo tono — sube de medio a alto, como preguntar «¿qué?»",
              "pt-BR": "Segundo tono — sobe do médio ao alto, como perguntar «o quê?»"
            }
          },
          {
            "syllable": "ma3",
            "pinyin": "mǎ",
            "toneNumber": 3,
            "meaning": {
              "ru": "лошадь (马)",
              "en": "horse (马)",
              "es": "caballo (马)",
              "pt-BR": "cavalo (马)"
            },
            "contourDescription": {
              "ru": "Третий тон — сначала опускается, затем поднимается (полный тон).",
              "en": "Third tone — dips down then rises (full tone).",
              "es": "Tercer tono — baja y luego sube (tono completo).",
              "pt-BR": "Terceiro tono — desce e depois sobe (tono completo)."
            }
          },
          {
            "syllable": "ma4",
            "pinyin": "mà",
            "toneNumber": 4,
            "meaning": {
              "ru": "ругать (骂)",
              "en": "to scold (骂)",
              "es": "regañar (骂)",
              "pt-BR": "repreender (骂)"
            },
            "contourDescription": {
              "ru": "Четвёртый тон — резко падает с высокого к низкому.",
              "en": "Fourth tone — falls sharply from high to low.",
              "es": "Cuarto tono — cae bruscamente de alto a bajo.",
              "pt-BR": "Quarto tono — cai abruptamente do alto ao baixo."
            }
          }
        ],
        "neutralToneNote": {
          "ru": "Нейтральный тон (без знака) часто короче и мягче, например частица 吗 (ma) в конце вопроса.",
          "en": "The neutral tone (no mark) is often shorter and softer, e.g. the particle 吗 (ma) at the end of a question.",
          "es": "El tono neutro (sin marca) suele ser más corto y suave, por ejemplo la partícula 吗 (ma) al final de una pregunta.",
          "pt-BR": "O tono neutro (sem marca) é frequentemente mais curto e suave, por exemplo a partícula 吗 (ma) no final de uma pergunta."
        },
        "toneMarkNote": {
          "ru": "Знак тона ставится на главную гласную слога: mā, má, mǎ, mà. В 你好 третий тон в 你 часто звучит ближе к второму: nǐ hǎo → ní hǎo.",
          "en": "The tone mark goes on the main vowel: mā, má, mǎ, mà. In 你好 the third tone in 你 often sounds closer to the second: nǐ hǎo → ní hǎo.",
          "es": "La marca tonal va en la vocal principal: mā, má, mǎ, mà. En 你好 el tercer tono de 你 suena más cercano al segundo: nǐ hǎo → ní hǎo.",
          "pt-BR": "A marca tonal vai na vocal principal: mā, má, mǎ, mà. Em 你好 o terceiro tono de 你 soa mais próximo do segundo: nǐ hǎo → ní hǎo."
        }
      },
      "grammarCard": null,
      "sections": [],
      "activities": []
    },
