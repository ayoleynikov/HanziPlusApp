    {
      "id": "lesson_01_ch03",
      "number": 3,
      "title": {
        "ru": "Первый вопрос",
        "en": "First question",
        "es": "Primera pregunta",
        "pt-BR": "Primeira pergunta"
      },
      "goal": {
        "ru": "Спросить «как ты?» с 吗 и ответить «очень хорошо».",
        "en": "Ask “how are you?” with 吗 and answer “very good.”",
        "es": "Preguntar «¿cómo estás?» con 吗 y responder «muy bien».",
        "pt-BR": "Perguntar «como você está?» com 吗 e responder «muito bem»."
      },
      "estimatedMinutes": 12,
      "toneGuide": null,
      "grammarCard": {
        "id": "l01_ma_question",
        "title": {
          "ru": "Вопрос с 吗",
          "en": "Questions with 吗",
          "es": "Preguntas con 吗",
          "pt-BR": "Perguntas com 吗"
        },
        "explanation": {
          "ru": "Частица 吗 в конце превращает утверждение в вопрос «да/нет». Перед 吗 не ставят 不. 不 перед четвёртым тоном читается как bú.",
          "en": "The particle 吗 at the end turns a statement into a yes/no question. 不 before a fourth-tone syllable is read bú.",
          "es": "La partícula 吗 al final convierte una frase en pregunta de sí/no. 不 antes de un tono cuarto se lee bú.",
          "pt-BR": "A partícula 吗 no final transforma uma frase em pergunta de sim/não. 不 antes de um quarto tono se lê bú."
        },
        "formula": {
          "ru": "Утверждение + 吗",
          "en": "Statement + 吗",
          "es": "Oración + 吗",
          "pt-BR": "Frase + 吗"
        },
        "positiveExample": {
          "hanzi": "你好。",
          "pinyin": "Nǐ hǎo.",
          "translation": {
            "ru": "Привет.",
            "en": "Hello.",
            "es": "Hola.",
            "pt-BR": "Olá."
          }
        },
