        "id": "dialogue_study_chinese",
        "title": "学习汉语",
        "lines": [
          {
            "speaker": "A",
            "hanzi": "你学俄语吗？",
            "pinyin": "Nǐ xué Éyǔ ma?",
            "translation": {
              "ru": "Ты учишь русский?",
              "en": "Do you study Russian?",
              "es": "¿Estudias ruso?",
              "pt-BR": "Você estuda russo?"
            },
            "audioKey": null
          },
          {
            "speaker": "B",
            "hanzi": "不，学汉语。",
            "pinyin": "Bù, xué Hànyǔ.",
            "translation": {
              "ru": "Нет, учу китайский.",
              "en": "No, I study Chinese.",
              "es": "No, estudio chino.",
              "pt-BR": "Não, estudo chinês."
            },
            "audioKey": null
          },
          {
            "speaker": "A",
            "hanzi": "去北京吗？",
            "pinyin": "Qù Běijīng ma?",
            "translation": {
              "ru": "Едешь в Пекин?",
              "en": "Are you going to Beijing?",
              "es": "¿Vas a Pekín?",
              "pt-BR": "Você vai para Pequim?"
            },
            "audioKey": null
          },
          {
            "speaker": "B",
            "hanzi": "对。",
            "pinyin": "Duì.",
            "translation": {
              "ru": "Да.",
              "en": "Yes.",
              "es": "Sí.",
              "pt-BR": "Sim."
            },
            "audioKey": null
          }
        ]
      }
    },
