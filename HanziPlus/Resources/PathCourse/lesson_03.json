    {
      "kind": "dialogue",
      "continueButtonTitle": "Дальше",
      "showLessonHeader": false,
      "dialogue": {
        "id": "dialogue_see_tomorrow",
        "title": "明天见",
        "lines": [
          {
            "speaker": "A",
            "hanzi": "你去邮局寄信吗？",
            "pinyin": "Nǐ qù yóujú jì xìn ma?",
            "translation": {
              "ru": "Ты идёшь на почту отправить письмо?",
              "en": "Are you going to the post office to mail a letter?",
              "es": "¿Vas a la oficina de correos a enviar una carta?",
              "pt-BR": "Você vai aos correios enviar uma carta?"
            },
            "audioKey": null
          },
          {
            "speaker": "B",
            "hanzi": "不去。去银行取钱。",
            "pinyin": "Bù qù. Qù yínháng qǔ qián.",
            "translation": {
              "ru": "Нет. Иду в банк снять деньги.",
              "en": "No. I'm going to the bank to withdraw money.",
              "es": "No. Voy al banco a sacar dinero.",
              "pt-BR": "Não. Vou ao banco sacar dinheiro."
            },
            "audioKey": null
          },
          {
            "speaker": "A",
            "hanzi": "明天见！",
            "pinyin": "Míngtiān jiàn!",
            "translation": {
              "ru": "До завтра!",
              "en": "See you tomorrow!",
              "es": "¡Hasta mañana!",
              "pt-BR": "Até amanhã!"
            },
            "audioKey": null
          },
          {
            "speaker": "B",
            "hanzi": "明天见！",
            "pinyin": "Míngtiān jiàn!",
            "translation": {
              "ru": "До завтра!",
              "en": "See you tomorrow!",
              "es": "¡Hasta mañana!",
              "pt-BR": "Até amanhã!"
            },
            "audioKey": null
          }
        ]
      }
