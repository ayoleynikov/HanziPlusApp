{
  "id": "lesson_07",
  "number": 7,
  "sourceLessonNumbers": [
    7
  ],
  "chineseTitle": "你吃什么",
  "chineseSubtitle": null,
  "pinyinTitle": "Nǐ chī shénme",
  "translationTitle": {
    "ru": "Что ты ешь?",
    "en": "What are you eating?",
    "es": "¿Qué comes?",
    "pt-BR": "O que você come?"
  },
  "sections": [
    {
      "kind": "dialogue",
      "continueButtonTitle": "Изучить новые слова",
      "showLessonHeader": true,
      "dialogue": {
        "id": "dialogue_main",
        "title": null,
        "lines": [
          {
            "speaker": "A",
            "hanzi": "中午你去哪儿吃饭？",
            "pinyin": "Zhōngwǔ nǐ qù nǎr chī fàn?",
            "translation": {
              "ru": "Где ты обедаешь в полдень?",
              "en": "Where do you eat lunch at noon?",
              "es": "¿Dónde almuerzas al mediodía?",
              "pt-BR": "Onde você almoça ao meio-dia?"
            },
            "audioKey": null
          },
          {
            "speaker": "B",
            "hanzi": "我去食堂。",
            "pinyin": "Wǒ qù shítáng.",
            "translation": {
              "ru": "Я иду в столовую.",
              "en": "I'm going to the cafeteria.",
              "es": "Voy al comedor.",
              "pt-BR": "Vou ao refeitório."
            },
            "audioKey": null
          },
          {
            "speaker": "A",
            "hanzi": "你吃什么？",
            "pinyin": "Nǐ chī shénme?",
            "translation": {
              "ru": "Что ты ешь?",
              "en": "What are you eating?",
              "es": "¿Qué comes?",
              "pt-BR": "O que você come?"
            },
            "audioKey": null
          },
          {
            "speaker": "B",
            "hanzi": "我吃馒头。",
            "pinyin": "Wǒ chī mántou.",
            "translation": {
              "ru": "Я ем маньтоу.",
              "en": "I'm eating mantou.",
              "es": "Como mantou.",
              "pt-BR": "Como mantou."
            },
            "audioKey": null
          },
          {
            "speaker": "A",
            "hanzi": "你要几个？",
            "pinyin": "Nǐ yào jǐ ge?",
            "translation": {
              "ru": "Сколько тебе?",
              "en": "How many do you want?",
              "es": "¿Cuántos quieres?",
              "pt-BR": "Quantos você quer?"
            },
            "audioKey": null
          },
          {
            "speaker": "B",
            "hanzi": "一个。你吃吗？",
            "pinyin": "Yí ge. Nǐ chī ma?",
            "translation": {
              "ru": "Один. Ты будешь?",
              "en": "One. Will you eat some?",
              "es": "Uno. ¿Comes?",
              "pt-BR": "Um. Você come?"
            },
            "audioKey": null
          },
          {
            "speaker": "A",
            "hanzi": "不吃，我吃米饭。你喝什么？",
            "pinyin": "Bù chī, wǒ chī mǐfàn. Nǐ hē shénme?",
            "translation": {
              "ru": "Нет, я ем рис. Что ты пьёшь?",
              "en": "No, I'm eating rice. What are you drinking?",
              "es": "No, como arroz. ¿Qué bebes?",
              "pt-BR": "Não, como arroz. O que você bebe?"
            },
            "audioKey": null
          },
          {
            "speaker": "B",
            "hanzi": "我要一碗鸡蛋汤。你喝吗？",
            "pinyin": "Wǒ yào yì wǎn jīdàn tāng. Nǐ hē ma?",
            "translation": {
              "ru": "Я хочу миску яичного супа. Ты будешь?",
              "en": "I want a bowl of egg soup. Will you have some?",
              "es": "Quiero un bol de sopa de huevo. ¿Bebes?",
              "pt-BR": "Quero uma tigela de sopa de ovo. Você bebe?"
            },
            "audioKey": null
          },
          {
            "speaker": "A",
            "hanzi": "不喝，我喝啤酒。",
            "pinyin": "Bù hē, wǒ hē píjiǔ.",
            "translation": {
              "ru": "Нет, я пью пиво.",
              "en": "No, I'm drinking beer.",
              "es": "No, bebo cerveza.",
              "pt-BR": "Não, bebo cerveja."
            },
            "audioKey": null
          },
          {
            "speaker": "B",
            "hanzi": "这些是什么？",
            "pinyin": "Zhèxiē shì shénme?",
            "translation": {
              "ru": "Что это?",
              "en": "What are these?",
              "es": "¿Qué son estos?",
              "pt-BR": "O que são estes?"
            },
            "audioKey": null
          },
          {
            "speaker": "A",
            "hanzi": "这是饺子，这是包子，那是面条儿。",
            "pinyin": "Zhè shì jiǎozi, zhè shì bāozi, nà shì miàntiáor.",
            "translation": {
              "ru": "Это цзяоцзы, это баоцзы, там лапша.",
              "en": "These are jiaozi, these are baozi, that is noodles.",
              "es": "Estos son jiaozi, estos son baozi, aquello son fideos.",
              "pt-BR": "Estes são jiaozi, estes são baozi, aquilo são macarrão."
            },
            "audioKey": null
          }
        ]
      }
    },
