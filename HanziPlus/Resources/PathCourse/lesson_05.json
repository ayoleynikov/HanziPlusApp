  "chineseTitle": "这是王老师",
  "chineseSubtitle": null,
  "pinyinTitle": "Zhè shì Wáng lǎoshī",
  "translationTitle": {
    "ru": "Это учитель Ван",
    "en": "This is Teacher Wang",
    "es": "Este es el profesor Wang",
    "pt-BR": "Este é o professor Wang"
  },
  "sections": [
    {
      "kind": "dialogue",
      "continueButtonTitle": "Изучить новые слова",
      "showLessonHeader": true,
      "dialogue": {
        "id": "dialogue_main",
        "title": null,
        "lines": [
          {
            "speaker": "A",
            "hanzi": "这是王老师，这是我爸爸。",
            "pinyin": "Zhè shì Wáng lǎoshī, zhè shì wǒ bàba.",
            "translation": {
              "ru": "Это учитель Ван, это мой папа.",
              "en": "This is Teacher Wang. This is my dad.",
              "es": "Este es el profesor Wang. Este es mi papá.",
              "pt-BR": "Este é o professor Wang. Este é meu pai."
            },
            "audioKey": null
          },
          {
            "speaker": "B",
            "hanzi": "王老师，您好！",
            "pinyin": "Wáng lǎoshī, nín hǎo!",
            "translation": {
              "ru": "Здравствуйте, учитель Ван!",
              "en": "Hello, Teacher Wang!",
              "es": "¡Hola, profesor Wang!",
              "pt-BR": "Olá, professor Wang!"
            },
            "audioKey": null
          },
          {
            "speaker": "C",
            "hanzi": "您好！请进！请坐！请喝茶！",
            "pinyin": "Nín hǎo! Qǐng jìn! Qǐng zuò! Qǐng hē chá!",
            "translation": {
              "ru": "Здравствуйте! Проходите! Садитесь! Пейте чай!",
              "en": "Hello! Come in! Sit down! Have some tea!",
              "es": "¡Hola! ¡Pase! ¡Siéntese! ¡Tome té!",
              "pt-BR": "Olá! Entre! Sente-se! Tome chá!"
            },
            "audioKey": null
          },
          {
            "speaker": "B",
            "hanzi": "谢谢！",
            "pinyin": "Xièxie!",
            "translation": {
              "ru": "Спасибо!",
              "en": "Thank you!",
              "es": "¡Gracias!",
              "pt-BR": "Obrigado!"
            },
            "audioKey": null
          },
          {
            "speaker": "C",
            "hanzi": "不客气！",
            "pinyin": "Bú kèqi!",
            "translation": {
              "ru": "Пожалуйста!",
              "en": "You're welcome!",
              "es": "¡De nada!",
              "pt-BR": "De nada!"
            },
            "audioKey": null
          },
          {
            "speaker": "C",
            "hanzi": "工作忙吗？",
            "pinyin": "Gōngzuò máng ma?",
            "translation": {
              "ru": "Работа занимает много времени?",
              "en": "Are you busy with work?",
              "es": "¿Está ocupado con el trabajo?",
              "pt-BR": "Está ocupado com o trabalho?"
            },
            "audioKey": null
          },
          {
            "speaker": "B",
            "hanzi": "不太忙。",
            "pinyin": "Bù tài máng.",
            "translation": {
              "ru": "Не очень.",
              "en": "Not too busy.",
              "es": "No mucho.",
              "pt-BR": "Não muito."
            },
            "audioKey": null
          },
          {
            "speaker": "C",
            "hanzi": "身体好吗？",
            "pinyin": "Shēntǐ hǎo ma?",
            "translation": {
              "ru": "Как здоровье?",
              "en": "How is your health?",
              "es": "¿Cómo está de salud?",
              "pt-BR": "Como está a saúde?"
            },
            "audioKey": null
          },
          {
            "speaker": "B",
            "hanzi": "很好！",
            "pinyin": "Hěn hǎo!",
            "translation": {
              "ru": "Очень хорошо!",
              "en": "Very good!",
              "es": "¡Muy bien!",
              "pt-BR": "Muito bem!"
            },
            "audioKey": null
          }
        ]
      }
    },
