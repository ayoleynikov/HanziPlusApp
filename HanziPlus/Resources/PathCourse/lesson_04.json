  },
  "sections": [
    {
      "kind": "dialogue",
      "continueButtonTitle": "Изучить новые слова",
      "showLessonHeader": true,
      "dialogue": {
        "id": "dialogue_where_go",
        "title": "你去哪儿",
        "lines": [
          {
            "speaker": "A",
            "hanzi": "今天星期几？",
            "pinyin": "Jīntiān xīngqī jǐ?",
            "translation": {
              "ru": "Какой сегодня день недели?",
              "en": "What day of the week is it today?",
              "es": "¿Qué día de la semana es hoy?",
              "pt-BR": "Que dia da semana é hoje?"
            },
            "audioKey": null
          },
          {
            "speaker": "B",
            "hanzi": "今天星期二。",
            "pinyin": "Jīntiān xīngqī'èr.",
            "translation": {
              "ru": "Сегодня вторник.",
              "en": "Today is Tuesday.",
              "es": "Hoy es martes.",
              "pt-BR": "Hoje é terça-feira."
            },
            "audioKey": null
          },
          {
            "speaker": "A",
            "hanzi": "你去哪儿？",
            "pinyin": "Nǐ qù nǎr?",
            "translation": {
              "ru": "Куда ты идёшь?",
              "en": "Where are you going?",
              "es": "¿A dónde vas?",
              "pt-BR": "Para onde você vai?"
            },
            "audioKey": null
          },
          {
            "speaker": "B",
            "hanzi": "我去天安门，你去不去？",
            "pinyin": "Wǒ qù Tiān'ānmén, nǐ qù bu qù?",
            "translation": {
              "ru": "Я иду на Тяньаньмэнь, ты идёшь?",
              "en": "I'm going to Tiananmen. Are you coming?",
              "es": "Voy a Tiananmen. ¿Vienes?",
              "pt-BR": "Vou à Tiananmen. Você vem?"
            },
            "audioKey": null
          },
          {
            "speaker": "A",
            "hanzi": "不去，我回学校。",
            "pinyin": "Bù qù, wǒ huí xuéxiào.",
            "translation": {
              "ru": "Нет, я иду в школу.",
              "en": "No, I'm going back to school.",
              "es": "No, vuelvo a la escuela.",
              "pt-BR": "Não, volto para a escola."
            },
            "audioKey": null
          },
          {
            "speaker": "B",
            "hanzi": "再见！",
            "pinyin": "Zàijiàn!",
            "translation": {
              "ru": "До свидания!",
              "en": "Goodbye!",
              "es": "¡Adiós!",
              "pt-BR": "Tchau!"
            },
            "audioKey": null
          },
          {
            "speaker": "A",
            "hanzi": "再见！",
            "pinyin": "Zàijiàn!",
            "translation": {
              "ru": "До свидания!",
              "en": "Goodbye!",
              "es": "¡Adiós!",
              "pt-BR": "Tchau!"
            },
            "audioKey": null
          }
        ]
      }
    },
