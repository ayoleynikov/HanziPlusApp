    "journey.city.xian.introduction" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thirteen dynasties left their mark here — and 8,000 clay soldiers still stand guard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trece dinastías dejaron huella aquí, y ocho mil soldados de arcilla siguen de guardia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treze dinastias marcaram este lugar — e oito mil soldados de argila ainda guardam a cidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь правили тринадцать династий — и восемь тысяч глиняных воинов до сих пор стоят на страже."
          }
        }
      }
    },
