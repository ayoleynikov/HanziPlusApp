    "journey.attraction.xa-a4.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monk Xuanzang stored Sanskrit texts here after his epic journey to India. Climb the seven stories for a sweeping view of modern Xi'an spreading below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El monje Xuanzang guardó aquí textos sánscritos tras su viaje a la India. Sube siete plantas para ver Xi'an moderno extendiéndose abajo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O monge Xuanzang guardou aqui textos em sânscrito após a viagem à Índia. Suba sete andares para ver Xi'an moderno se espalhando abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
