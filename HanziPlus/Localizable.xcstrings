    "journey.city.guilin.introduction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discover Guilin — misty karst peaks rising from the Li River like a painted scroll."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Гуйлинь — туманные карстовые пики над рекой Ли, словно на свитке."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubre Guilin: picos kársticos neblinosos sobre el río Li como un rollo pintado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubra Guilin — picos cársticos enevoados sobre o rio Li como um pergaminho pintado."
          }
        }
      }
    },
    "journey.city.guilin.famousFor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Karst mountains, Li River cruises, and rice terraces"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карстовые горы, круизы по реке Ли и рисовые террасы"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Montañas kársticas, cruceros por el río Li y terrazas de arroz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Montanhas cársticas, cruzeiros no rio Li e terraços de arroz"
          }
        }
      }
    },
