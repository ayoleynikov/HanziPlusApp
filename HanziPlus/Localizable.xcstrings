            "state" : "translated",
            "value" : "Храм Ухоу"
          }
        }
      }
    },
    "journey.attraction.cd-a4.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combine with Jinli Street next door — one ticket covers both areas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combínalo con Jinli Street al lado: una entrada cubre ambas zonas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combine com a Rua Jinli ao lado — um ingresso cobre as duas áreas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Совместите с соседней Цзиньли — один билет на обе зоны."
          }
        }
      }
    },
    "journey.attraction.cd-a5.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open-air lanes where Qing courtyards meet flagship stores."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calles al aire libre donde patios Qing se encuentran con tiendas insignia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruas ao ar livre onde pátios Qing encontram lojas flagship."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открытые переулки, где дворы эпохи Цин соседствуют с флагманскими магазинами."
          }
        }
      }
    },
    "journey.attraction.cd-a5.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Built around the restored Daci Temple, Taikoo Li keeps Qing-era lanes while adding cocktail bars and the famous rooftop panda at IFS. Fashion and tea-house culture share the same block."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construido junto al templo Daci restaurado, conserva callejuelas Qing con bares y la famosa panda en la azotea del IFS. Moda y cultura del té comparten la misma manzana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construído em torno do templo Daci restaurado, mantém becos Qing com bares e a famosa panda no terraço do IFS. Moda e cultura do chá dividem o mesmo quarteirão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Построен вокруг отреставрированного храма Дацзы: переулки эпохи Цин, коктейль-бары и знаменитая панда на крыше IFS. Мода и чайная культура живут на одной улице."
          }
        }
      }
    },
    "journey.attraction.cd-a5.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
