          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восточная жемчужина"
          }
        }
      }
    },
    "journey.attraction.sh-a2.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visit the lower observation sphere at dusk — city lights switch on as you ascend."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube a la esfera inferior al atardecer: las luces se encienden mientras asciendes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suba à esfera inferior ao pôr do sol — as luzes acendem enquanto você sobe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поднимитесь на нижнюю смотровую на закате — огни зажигаются во время подъёма."
          }
        }
      }
    },
    "journey.attraction.sh-a3.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classical Ming-era garden in Old City."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jardín clásico de la época Ming en la Ciudad Vieja."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jardim clássico da era Ming na Cidade Antiga."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Классический сад эпохи Мин в Старом городе."
          }
        }
      }
    },
    "journey.attraction.sh-a3.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Built in 1559 by a Ming official, Yu Garden packs pavilions, rockeries, and dragon walls into just two hectares. The surrounding bazaar sells snacks, tea, and souvenirs in a maze of lanes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construido en 1559 por un funcionario Ming, el jardín Yuyuan concentra pabellones, rocallas y muros con dragones en solo dos hectáreas. El bazar circundante vende bocadillos, té y souvenirs en un laberinto de callejuelas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construído em 1559 por um funcionário Ming, o Jardim Yuyuan concentra pavilhões, rochas ornamentais e muros com dragões em apenas dois hectares. O bazar ao redor vende petiscos, chá e souvenirs em um labirinto de becos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Построенный в 1559 году чиновником эпохи Мин, сад Юйюань в двух гектарах собрал павильоны, каменные горки и стены с драконами. Вокруг — базар с закусками, чаем и сувенирами в лабиринте улочек."
          }
        }
      }
    },
    "journey.attraction.sh-a3.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yu Garden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jardín Yuyuan"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jardim Yuyuan"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сад Юйюань"
          }
        }
      }
    },
    "journey.attraction.sh-a3.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter through the Huxinting Teahouse — the pond-side pavilion is picture-perfect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entra por la casa de té Huxinting: el pabellón junto al estanque es perfecto para fotos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre pela casa de chá Huxinting — o pavilhão à beira do lago é perfeito para fotos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зайдите через чайную Хусинтин — павильон у пруда идеален для фото."
          }
        }
      }
    },
    "journey.attraction.sh-a4.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premier shopping street, dazzling at night."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La principal calle comercial, deslumbrante por la noche."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A principal rua comercial, deslumbrante à noite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Главная торговая улица, сияющая огнями ночью."
          }
        }
      }
    },
    "journey.attraction.sh-a4.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stretching from the Bund to People's Square, Nanjing Road has been Shanghai's shopping spine for over a century. Neon signs, flagship stores, and street performers pack the pedestrian section after dark."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desde el Bund hasta la Plaza del Pueblo, Nanjing Road lleva un siglo como eje comercial de Shanghái. Neones, tiendas insignia y artistas callejeros llenan la zona peatonal al anochecer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do Bund à Praça do Povo, a Rua Nanjing é o eixo comercial de Xangai há mais de um século. Néon, lojas flagship e artistas de rua lotam a área pedestre depois do anoitecer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "От Бунда до Народной площади Нанкинская улица — торговая ось Шанхая уже больше века. Неон, флагманские магазины и уличные артисты заполняют пешеходную часть после заката."
          }
        }
      }
    },
    "journey.attraction.sh-a4.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanjing Road"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calle Nanjing"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rua Nanjing"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нанкинская улица"
          }
        }
      }
    },
    "journey.attraction.sh-a4.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ride the historic Dangdang sightseeing tram through the neon-lit section."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube al tranvía turístico histórico Dangdang por la sección iluminada de neón."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pegue o bonde turístico histórico Dangdang pela seção iluminada de néon."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокатитесь на историческом трамвае Dangdang по неоновой части улицы."
          }
        }
      }
    },
    "journey.attraction.sh-a5.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Art galleries and riverfront parks on the Puxi waterfront."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galerías y parques junto al río en el Bund Oeste."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galerias e parques à beira do rio no Bund Oeste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Галереи и парки на набережной Пуси."
          }
        }
      }
    },
    "journey.attraction.sh-a5.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once industrial docks, the West Bund now hosts the Long Museum, Yuz Museum, and open-air sculpture parks along the Huangpu. Sunset joggers and art walkers share the 8-km riverside promenade."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antiguos muelles industriales, el Bund Oeste alberga hoy el Long Museum, el Yuz Museum y parques de esculturas junto al Huangpu. Corredores y visitantes de arte comparten el paseo de 8 km."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antigos cais industriais, o Bund Oeste abriga hoje o Long Museum, o Yuz Museum e parques de esculturas ao longo do Huangpu. Corredores e visitantes de arte dividem o calçadão de 8 km."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бывшие промышленные причалы Западного Бунда теперь — музеи Long и Yuz и парки скульптур вдоль Хуанпу. Бегуны и любители искусства делят 8-километровую набережную."
          }
        }
      }
    },
    "journey.attraction.sh-a5.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "West Bund"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bund Oeste"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bund Oeste"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Западный Бунд"
          }
        }
      }
    },
    "journey.attraction.sh-a5.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combine a gallery visit with an evening walk — the waterfront lights up after sunset."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combina una galería con un paseo al anochecer: el paseo marítimo se ilumina tras el atardecer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combine uma galeria com uma caminhada ao entardecer — a orla se ilumina depois do pôr do sol."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Совместите галерею с вечерней прогулкой — набережная зажигается после заката."
          }
        }
      }
    },
    "journey.attraction.sz-a1.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ming-era garden of ponds and pavilions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jardín de la época Ming con estanques y pabellones."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jardim da era Ming com lagos e pavilhões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сад эпохи Мин с прудами и павильонами."
          }
        }
      }
    },
    "journey.attraction.sz-a1.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One of China's four great gardens, the Humble Administrator's Garden layers ponds, rockeries, and pavilions across 52,000 square meters. Every turn reveals a new framed view — water, bamboo, and whitewashed walls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno de los cuatro grandes jardines de China, el Jardín del Administrador Humilde superpone estanques, rocallas y pabellones en 52 000 metros cuadrados. Cada giro revela una nueva vista: agua, bambú y paredes blancas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um dos quatro grandes jardins da China, o Jardim do Administrador Humilde empilha lagos, rochas ornamentais e pavilhões em 52 mil metros quadrados. Cada curva revela uma nova vista: água, bambu e paredes brancas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один из четырёх великих садов Китая — сад скромного чиновника раскладывает пруды, каменные горки и павильоны на 52 000 квадратных метров. На каждом повороте — новый кадр: вода, бамбук и белые стены."
          }
        }
      }
    },
    "journey.attraction.sz-a1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Humble Garden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jardín del Administrador Humilde"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jardim do Administrador Humilde"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сад скромного чиновника"
          }
        }
      }
    },
    "journey.attraction.sz-a1.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visit on a weekday morning — weekend crowds make the narrow paths feel packed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visita un día laborable por la mañana: los fines de semana los caminos estrechos se llenan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visite em dia de semana de manhã — nos fins de semana os caminhos estreitos ficam lotados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приезжайте в будни утром — в выходные узкие дорожки переполнены."
          }
        }
      }
    },
    "journey.attraction.sz-a2.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaning pagoda atop a legendary hill."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagoda inclinada sobre una colina legendaria."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagode inclinado no alto de uma colina lendária."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наклонная пагода на вершине легендарного холма."
          }
        }
      }
    },
    "journey.attraction.sz-a2.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiger Hill's 1,000-year-old Yunyan Pagoda leans noticeably like a smaller Pisa tower. Legend says a tiger appeared here after a white heron landed — the hill's name and mystique endure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pagoda Yunyan de mil años en la Colina del Tigre se inclina como una Pisa pequeña. La leyenda dice que un tigre apareció aquí tras una garza blanca — el nombre y el misterio perduran."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O pagode Yunyan de mil anos na Colina do Tigre inclina como uma Pisa menor. A lenda diz que um tigre apareceu aqui após uma garça branca — o nome e o mistério do morro persistem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тысячелетняя пагода Юньянь на Тигровом холме заметно наклонена, как маленькая Пиза. Легенда гласит, что здесь появился тигр после белой цапли — название и мистика холма живы."
          }
        }
      }
    },
    "journey.attraction.sz-a2.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiger Hill"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colina del Tigre"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colina do Tigre"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тигровый холм"
          }
        }
      }
    },
    "journey.attraction.sz-a2.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Climb to the pagoda base for the best angle on the lean — photos work best from the south side."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube a la base de la pagoda: desde el lado sur el inclinamiento se ve mejor en fotos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suba à base do pagode — do lado sul o inclinamento aparece melhor nas fotos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поднимитесь к основанию пагоды — с южной стороны наклон виден лучше всего."
          }
        }
      }
    },
    "journey.attraction.sz-a3.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canalside lane of teahouses and shops."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calle junto al canal con casas de té y tiendas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rua à beira do canal com casas de chá e lojas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Улица вдоль канала с чайными и магазинами."
          }
        }
      }
    },
    "journey.attraction.sz-a3.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pingjiang Historic Street threads 800 meters of stone lanes beside a canal lined with willows. Teahouses, craft shops, and Kunqu opera performances keep the old Suzhou atmosphere alive day and night."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La calle histórica Pingjiang recorre 800 metros de callejuelas de piedra junto a un canal con sauces. Casas de té, talleres y ópera Kunqu mantienen viva la atmósfera del Suzhou antiguo día y noche."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rua histórica Pingjiang percorre 800 metros de becos de pedra ao lado de um canal com salgueiros. Casas de chá, oficinas e ópera Kunqu mantêm viva a atmosfera do Suzhou antigo dia e noite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Историческая улица Пинцзян — 800 метров каменных улочек вдоль канала с ивами. Чайные, мастерские и представления оперы куньцю сохраняют атмосферу старого Сучжоу днём и ночью."
          }
        }
      }
    },
    "journey.attraction.sz-a3.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pingjiang Road"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calle Pingjiang"
          }
        },
        "pt-BR" : {
