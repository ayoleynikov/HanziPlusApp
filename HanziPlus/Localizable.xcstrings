          }
        }
      }
    },
    "journey.attraction.cd-a2.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visit after dark when lanterns switch on — daytime feels like a shopping mall."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visita de noche cuando encienden farolillos; de día parece un centro comercial."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visite depois do anoitecer, quando acendem as lanternas — de dia parece shopping."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приходите после заката, когда зажигают фонари — днём это похоже на торговый центр."
          }
        }
      }
    },
    "journey.attraction.cd-a3.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bubbling chili broth that numbs and delights in equal measure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caldo hirviendo picante que adormece y deleita a la vez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caldo borbulhante picante que adormece e encanta ao mesmo tempo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кипящий острый бульон, который одновременно онемляет и радует."
          }
        }
      }
    },
    "journey.attraction.cd-a3.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A split pot lets you choose fiery red oil or mild mushroom broth. Dip thin-sliced beef and lotus root, then cool your tongue with sesame paste or iced plum juice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una olla dividida permite caldo rojo ardiente o suave de hongos. Sumerge ternera y raíz de loto, y enfría la lengua con pasta de sésamo o zumo de ciruela."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma panela dividida permite caldo vermelho ardente ou suave de cogumelos. Mergulhe carne e raiz de lótus e refresque a língua com pasta de gergelim ou suco de ameixa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С двойным котлом можно выбрать огненное масло или лёгкий грибной бульон. Окуните говядину и лотос, а язык остудите кунжутной пастой или сливовым соком."
          }
        }
      }
    },
    "journey.attraction.cd-a3.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hot Pot"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hot pot"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hot pot"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сычуаньский хого"
          }
        }
      }
    },
    "journey.attraction.cd-a3.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask for yuanyang (half-and-half) pot if your group mixes spice tolerance levels."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide olla yuanyang (mitad y mitad) si el grupo tolera picante distinto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça panela yuanyang (metade e metade) se o grupo tolera picância diferente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закажите котёл «юаньян» (половина-половина), если в компании разная любовь к острому."
          }
        }
      }
    },
    "journey.attraction.cd-a4.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temple honoring heroes of the Three Kingdoms era."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Templo dedicado a los héroes de los Tres Reinos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Templo dedicado aos heróis dos Três Reinos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храм в честь героев эпохи Троецарствия."
          }
        }
      }
    },
    "journey.attraction.cd-a4.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dedicated to strategist Zhuge Liang, the shrine sits beside the Tomb of Liu Bei. Red walls, ancient cypress trees, and stone steles tell tales of loyalty and battlefield cunning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dedicado al estratega Zhuge Liang, el templo está junto a la tumba de Liu Bei. Muros rojos, cipreses antiguos y estelas de piedra cuentan lealtad y astucia en batalla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dedicado ao estrategista Zhuge Liang, fica ao lado do túmulo de Liu Bei. Muros vermelhos, ciprestes antigos e estelas de pedra contam lealdade e astúcia na batalha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храм посвящён стратегу Чжугэ Ляну и стоит рядом с гробницей Лю Бэя. Алые стены, старые кипарисы и каменные стелы рассказывают о верности и военной хитрости."
          }
        }
      }
    },
    "journey.attraction.cd-a4.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wuhou Shrine"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
