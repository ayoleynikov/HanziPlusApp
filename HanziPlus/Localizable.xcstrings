            "state" : "translated",
            "value" : "Река Ли"
          }
        }
      }
    },
    "journey.attraction.gl-a1.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Book the morning cruise — light is softer and the river is calmer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reserva el crucero de mañana: la luz es más suave y el río más tranquilo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reserve o cruzeiro da manhã — a luz é mais suave e o rio mais calmo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Берите утренний круиз — свет мягче и на реке тише."
          }
        }
      }
    },
    "journey.attraction.gl-a2.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
