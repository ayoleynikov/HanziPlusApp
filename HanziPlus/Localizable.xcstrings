    "journey.attraction.sh-a1.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colonial waterfront facing Pudong's towers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paseo colonial frente a las torres de Pudong."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orla colonial diante das torres de Pudong."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Историческая набережная напротив небоскрёбов Пудуна."
          }
        }
      }
    },
    "journey.attraction.sh-a1.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fifty-two heritage buildings line the Huangpu River waterfront, facing Pudong's futuristic skyline across the water. The contrast between 1920s neoclassical facades and glass supertalls defines modern Shanghai."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cincuenta y dos edificios patrimoniales bordean el Huangpu frente al horizonte futurista de Pudong. El contraste entre fachadas neoclásicas de los años 20 y rascacielos de cristal define el Shanghái moderno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinquenta e dois edifícios históricos margeiam o Huangpu diante do horizonte futurista de Pudong. O contraste entre fachadas neoclássicas dos anos 20 e supertorres de vidro define a Xangai moderna."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пятьдесят два исторических здания вдоль набережной Хуанпу смотрят на футуристический Пудун через реку. Контраст неоклассики 1920-х и стеклянных небоскрёбов — лицо современного Шанхая."
          }
        }
      }
    },
    "journey.attraction.sh-a1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Bund"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Bund"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Bund"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Набережная Бунд"
          }
        }
      }
    },
    "journey.attraction.sh-a1.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walk the Bund at night, then cross to Pudong for the skyline view back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorre el Bund de noche y cruza a Pudong para ver el horizonte desde el otro lado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caminhe no Bund à noite e cruze para Pudong para ver o horizonte do outro lado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гуляйте по Бунду ночью, затем перейдите в Пудун — вид на набережную с другого берега."
          }
        }
      }
    },
    "journey.attraction.sh-a2.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iconic TV tower on the Pudong skyline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icónica torre de televisión del horizonte de Pudong."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icônica torre de TV no horizonte de Pudong."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знаменитая телебашня в панораме Пудуна."
          }
        }
      }
    },
    "journey.attraction.sh-a2.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pink-and-silver spheres of the Oriental Pearl Tower punctuate Pudong's skyline since 1994. The observation decks and revolving restaurant offer 360-degree views of the entire megacity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las esferas rosa y plateadas de la Torre de la Perla Oriental marcan el horizonte de Pudong desde 1994. Las plataformas y el restaurante giratorio ofrecen vistas de 360° de la megaciudad."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As esferas rosa e prateadas da Torre Pérola Oriental marcam o horizonte de Pudong desde 1994. Os mirantes e o restaurante giratório oferecem vista de 360° da megacidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розовые и серебристые сферы Восточной жемчужины с 1994 года отмечают панораму Пудуна. Смотровые палубы и вращающийся ресторан открывают вид на весь мегаполис."
          }
        }
      }
    },
    "journey.attraction.sh-a2.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oriental Pearl"
          }
        },
        "es" : {
