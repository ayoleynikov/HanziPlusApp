          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пик Виктория"
          }
        }
      }
    },
    "journey.attraction.hk-a1.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ride the Peak Tram up and walk down the Lugard Road circuit for fewer crowds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube en el Peak Tram y baja por el circuito de Lugard Road para evitar multitudes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suba no Peak Tram e desça pelo circuito da Lugard Road para evitar multidões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поднимитесь на Peak Tram и спуститесь по кольцевой дороге Лугард — меньше толп."
          }
        }
      }
    },
    "journey.attraction.hk-a2.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historic harbor crossing at sunset."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Histórico cruce del puerto al atardecer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travessia histórica do porto ao pôr do sol."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Историческая переправа через гавань на закате."
          }
        }
      }
    },
    "journey.attraction.hk-a2.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Operating since 1888, the Star Ferry crosses Victoria Harbour between Central and Tsim Sha Tsui in about ten minutes. The ride costs less than a coffee but delivers Hong Kong's most iconic harbor panorama."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En funcionamiento desde 1888, el Star Ferry cruza el Puerto Victoria entre Central y Tsim Sha Tsui en unos diez minutos. El viaje cuesta menos que un café y ofrece la panorámica más icónica del puerto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em operação desde 1888, o Star Ferry cruza o Porto Victoria entre Central e Tsim Sha Tsui em cerca de dez minutos. A viagem custa menos que um café e traz a panorâmica mais icônica do porto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С 1888 года паром Star Ferry пересекает гавань Виктория между Central и Цим Ша Цуй за десять минут. Поездка дешевле чашки кофе, а вид на гавань — самый знаковый в Гонконге."
          }
        }
      }
    },
    "journey.attraction.hk-a2.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Star Ferry"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Star Ferry"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Star Ferry"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Паром Star Ferry"
          }
        }
      }
    },
    "journey.attraction.hk-a2.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take the Tsim Sha Tsui to Central route at sunset — sit on the upper deck starboard side."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toma la ruta Tsim Sha Tsui a Central al atardecer y siéntate en la cubierta superior a estribor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pegue a rota Tsim Sha Tsui a Central ao pôr do sol e sente-se no convés superior à estibordo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Берите маршрут Цим Ша Цуй — Central на закате, сидите на верхней палубе на правом борту."
          }
        }
      }
    },
    "journey.attraction.hk-a3.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Night market of street food, fortune tellers, and bargains."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mercado nocturno de comida callejera, adivinos y gangas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mercado noturno de comida de rua, cartomantes e pechinchas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ночной рынок с уличной едой, гадалками и торгом."
          }
        }
      }
    },
    "journey.attraction.hk-a3.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temple Street Night Market lights up after dark with seafood stalls, dai pai dong eateries, and fortune tellers under red lanterns. Bargain for electronics, clothes, and opera masks in the lively Kowloon atmosphere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mercado nocturno de Temple Street se enciende al anochecer con mariscos, dai pai dong y adivinos bajo farolillos rojos. Regatea electrónica, ropa y máscaras de ópera en el bullicio de Kowloon."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mercado noturno da Rua Temple acende depois do anoitecer com frutos do mar, dai pai dong e cartomantes sob lanternas vermelhas. Negocie eletrônicos, roupas e máscaras de ópera no clima agitado de Kowloon."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ночной рынок на улице Темпл зажигается после заката: морепродукты, уличные кафе и гадалки под красными фонарями. Торгуйте за электронику, одежду и маски оперы в оживлённой атмосфере Коулуна."
          }
        }
      }
    },
    "journey.attraction.hk-a3.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temple Street"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calle Temple"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rua Temple"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Улица Темпл"
          }
        }
      }
    },
    "journey.attraction.hk-a3.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eat at a dai pai dong stall — order typhoon shelter crab and clams with black bean sauce."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come en un dai pai dong: pide cangrejo typhoon shelter y almejas con salsa de frijol negro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coma em um dai pai dong — peça caranguejo typhoon shelter e mariscos com molho de feijão preto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ешьте в уличном кафе — закажите краба в пряном соусе и моллюски с чёрными бобами."
          }
        }
      }
    },
    "journey.attraction.hk-a4.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hong Kong's beloved brunch of steamed baskets and tea."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El brunch favorito de Hong Kong: cestas al vapor y té."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O brunch favorito de Hong Kong: cestas no vapor e chá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любимый бранч Гонконга — паровые корзинки и чай."
          }
        }
      }
    },
    "journey.attraction.hk-a4.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yum cha — drinking tea with dim sum — is Hong Kong's weekend ritual. Bamboo baskets deliver har gow shrimp dumplings, siu mai pork, and char siu buns while servers pour endless jasmine tea."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El yum cha — té con dim sum — es el ritual de fin de semana de Hong Kong. Cestas de bambú traen har gow, siu mai y bollos de char siu mientras sirven té de jazmín sin parar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O yum cha — chá com dim sum — é o ritual de fim de semana de Hong Kong. Cestas de bambu trazem har gow, siu mai e pães de char siu enquanto servem chá de jasmim sem parar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ямча — чай с димсамом — выходной ритуал Гонконга. Бамбуковые корзинки несут хар гау, сиу май и булочки с чар-сю, а официанты наливают бесконечный жасминовый чай."
          }
        }
      }
    },
    "journey.attraction.hk-a4.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dim Sum"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dim sum"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dim sum"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Димсам"
          }
        }
      }
    },
    "journey.attraction.hk-a4.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go early on Sunday morning — the best baskets sell out by 11 AM at popular teahouses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve temprano el domingo por la mañana: en las casas de té populares lo mejor se agota a las 11."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chegue cedo no domingo de manhã — nas casas de chá populares o melhor acaba às 11h."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приходите рано в воскресенье — в популярных чайных лучшие корзинки заканчиваются к 11:00."
          }
        }
      }
    },
    "journey.attraction.hk-a5.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asia's flagship museum of visual culture on the waterfront."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El museo insignia de cultura visual de Asia junto al mar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O museu flagship de cultura visual da Ásia à beira-mar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Главный музей визуальной культуры Азии на набережной."
          }
        }
      }
    },
    "journey.attraction.hk-a5.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M+ opened in 2021 as Hong Kong's museum of visual culture — art, design, architecture, and moving image. The Herzog & de Meuron building anchors the West Kowloon Cultural District with a bold skyline silhouette."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M+ abrió en 2021 como museo de cultura visual de Hong Kong: arte, diseño, arquitectura e imagen en movimiento. El edificio de Herzog & de Meuron ancla el distrito cultural de West Kowloon con un perfil audaz en el horizonte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M+ abriu em 2021 como museu de cultura visual de Hong Kong — arte, design, arquitetura e imagem em movimento. O prédio de Herzog & de Meuron ancora o distrito cultural de West Kowloon com um perfil marcante no horizonte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M+ открылся в 2021 году как музей визуальной культуры Гонконга — искусство, дизайн, архитектура и кинематограф. Здание бюро Herzog & de Meuron — опора культурного района Западного Коулуна с ярким силуэтом в панораме."
          }
        }
      }
    },
    "journey.attraction.hk-a5.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
