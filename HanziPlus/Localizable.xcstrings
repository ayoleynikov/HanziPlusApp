    "journey.attraction.szh-a4.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A former industrial area transformed into a lively arts district."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una antigua zona industrial convertida en un animado distrito artístico."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma antiga área industrial transformada em um animado distrito artístico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бывшая промышленная зона, превращённая в оживлённый арт-квартал."
          }
        }
      }
    },
    "journey.attraction.szh-a4.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OCT Loft converted 1980s factory warehouses into galleries, design studios, and indie bookshops. Weekend markets, live music, and craft beer bars give the red-brick courtyards a creative buzz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OCT Loft convirtió almacenes de fábrica de los años 80 en galerías, estudios de diseño y librerías independientes. Mercados de fin de semana, música en vivo y bares de cerveza artesanal animan los patios de ladrillo rojo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OCT Loft transformou armazéns de fábrica dos anos 80 em galerias, estúdios de design e livrarias independentes. Feiras de fim de semana, música ao vivo e bares de cerveja artesanal animam os pátios de tijolo vermelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OCT Loft превратил заводские склады 1980-х в галереи, дизайн-студии и независимые книжные. По выходным — рынки, живую музыку и бары с крафтовым пивом в краснокирпичных дворах."
          }
        }
      }
    },
    "journey.attraction.szh-a4.name" : {
      "extractionState" : "manual",
      "localizations" : {
