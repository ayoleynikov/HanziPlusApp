    "journey.attraction.xa-a1.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thousands of life-size clay soldiers guarding an emperor's tomb."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miles de soldados de arcilla de tamaño real custodian la tumba de un emperador."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Milhares de soldados de argila em tamanho real guardam a tumba de um imperador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тысячи глиняных воинов в натуральную величину охраняют гробницу императора."
          }
        }
      }
    },
    "journey.attraction.xa-a1.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discovered by farmers in 1974, the army was built to protect Qin Shi Huang in the afterlife. Each warrior has a unique face, hairstyle, and armor detail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descubierta por campesinos en 1974, el ejército protegía a Qin Shi Huang en el más allá. Cada guerrero tiene rostro, peinado y armadura únicos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descoberto por fazendeiros em 1974, o exército protegia Qin Shi Huang no além. Cada guerreiro tem rosto, penteado e armadura únicos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открытая в 1974 году фермерами, армия была создана, чтобы защищать Цинь Шихуана в загробном мире. У каждого воина своё лицо, причёска и доспехи."
          }
        }
      }
    },
    "journey.attraction.xa-a1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terracotta Army"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejército de Terracota"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exército de Terracota"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Терракотовая армия"
          }
        }
      }
    },
    "journey.attraction.xa-a1.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hire a guide or audio tour — the pits are easier to understand with context."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrata guía o audioguía: los fosos se entienden mejor con contexto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrate guia ou audioguia — as valas fazem mais sentido com contexto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возьмите гида или аудиогид — ямы легче понять с пояснениями."
          }
        }
      }
    },
    "journey.attraction.xa-a2.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cycle atop one of the world's best-preserved city walls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedale sobre una de las murallas urbanas mejor conservadas del mundo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedale sobre uma das muralhas urbanas mais bem preservadas do mundo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокатитесь по одной из лучше всего сохранившихся городских стен мира."
          }
        }
      }
    },
    "journey.attraction.xa-a2.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Ming-era wall loops 14 km around old Xi'an. Rent a bike and ride the full circuit for bird's-eye views of bell towers, moats, and rooftop gardens below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La muralla Ming rodea el Xi'an antiguo en 14 km. Alquila una bici y recorre el circuito completo con vistas a campanarios, fosos y jardines en azoteas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A muralha Ming contorna o Xi'an antigo em 14 km. Alugue uma bike e faça o circuito completo com vista para campanários, fossos e jardins nos telhados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стена эпохи Мин опоясывает старый Сиань на 14 км. Арендуйте велосипед и объедьте круг — открываются виды на колокольни, рвы и садики на крышах."
          }
        }
      }
    },
    "journey.attraction.xa-a2.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "City Wall"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muralla de la ciudad"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muralha da cidade"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Городская стена"
          }
        }
      }
    },
    "journey.attraction.xa-a2.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go at sunset — the wall glows gold and the city lights switch on below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve al atardecer: la muralla se tiñe de oro y abajo se encienden las luces."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vá no pôr do sol — a muralha fica dourada e as luzes acendem embaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приезжайте на закат — стена золотится, а внизу зажигаются огни."
          }
        }
      }
    },
    "journey.attraction.xa-a3.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleyways sizzling with street food and centuries of culture."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Callejuelas chisporroteantes de comida callejera y siglos de cultura."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Becos borbulhando de comida de rua e séculos de cultura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переулки, где шипит уличная еда и живёт многовековая культура."
          }
        }
      }
    },
    "journey.attraction.xa-a3.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Narrow lanes near the Great Mosque fill with lamb skewers, roujiamo burgers, and pomegranate juice presses. The area has been home to Hui Muslim communities since the Tang dynasty."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calles estrechas junto a la Gran Mezquita rebosan de brochetas de cordero, roujiamo y zumo de granada. Comunidades hui musulmanas viven aquí desde la dinastía Tang."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruas estreitas perto da Grande Mesquita enchem de espetinhos de cordeiro, roujiamo e suco de romã. Comunidades muçulmanas hui vivem aqui desde a dinastia Tang."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Узкие улочки у Большой мечети полны шашлыков, roujiamo и гранатового сока. Здесь с династии Тан живут мусульмане-хуэй."
          }
        }
      }
    },
    "journey.attraction.xa-a3.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muslim Quarter"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barrio musulmán"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bairro muçulmano"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мусульманский квартал"
          }
        }
      }
    },
    "journey.attraction.xa-a3.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come hungry at dusk — lines shorten once the dinner rush peaks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve con hambre al anochecer: las colas se acortan tras el pico de la cena."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chegue com fome ao entardecer — as filas diminuem depois do pico do jantar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приходите голодными ближе к вечеру — после пика ужина очереди короче."
          }
        }
      }
    },
    "journey.attraction.xa-a4.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tang-dynasty pagoda where Buddhist scriptures first arrived."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagoda Tang donde llegaron por primera vez las escrituras budistas."
