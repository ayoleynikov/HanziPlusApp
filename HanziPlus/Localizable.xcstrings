        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picos cársticos surgem do rio Li como um pergaminho vivo — sem filtro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карстовые вершины поднимаются из реки Ли, словно живой свиток — фильтры не нужны."
          }
        }
      }
