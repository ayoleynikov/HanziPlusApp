    "journey.city.guangzhou.introduction" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam rises from bamboo baskets at dawn — Guangzhou runs on dim sum and Pearl River energy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al amanecer sube el vapor de las cestas de bambú: Cantón funciona a dim sum y energía del río de las Perlas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao amanhecer o vapor sobe das cestas de bambu — Guangzhou vive de dim sum e da energia do Rio das Pérolas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На рассвете над бамбуковыми корзинками поднимается пар — Гуанчжоу живёт димсамом и энергией Жемчужной реки."
          }
        }
      }
    },
