    "language.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interface and study translations follow this choice. Chinese text and pronunciation stay Mandarin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Интерфейс и переводы слов следуют этому выбору. Китайский текст и озвучка остаются на путунхуа."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La interfaz y las traducciones siguen esta elección. El texto y la pronunciación chinos siguen siendo mandarín."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A interface e as traduções seguem esta escolha. O texto e a pronúncia em chinês continuam em mandarim."
          }
        }
      }
    },
