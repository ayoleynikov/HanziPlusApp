            "value" : "Музей M+"
          }
        }
      }
    },
    "journey.attraction.hk-a5.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visit the rooftop garden for free — the harbor view rivals the galleries inside."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visita el jardín en la azotea gratis: la vista del puerto rivaliza con las galerías."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visite o jardim no terraço gratuitamente — a vista do porto rivaliza com as galerias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загляните на крышный сад бесплатно — вид на гавань не уступает экспозициям."
          }
        }
      }
    },
    "journey.attraction.hz-a1.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willow-lined shores and misty pagodas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orillas con sauces y pagodas entre la niebla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Margens com salgueiros e pagodes entre a névoa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Берега, поросшие ивами, и пагоды в тумане."
          }
        }
      }
    },
    "journey.attraction.hz-a1.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "West Lake's ten scenic spots have inspired poets for a thousand years. Willow-lined causeways, lotus ponds, and misty pagodas make a slow boat ride or lakeside stroll the perfect Hangzhou ritual."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los diez paisajes del Lago del Oeste inspiraron poetas durante mil años. Calzadas con sauces, estanques de lotos y pagodas entre la niebla: un paseo en barca o junto al agua es el ritual perfecto de Hangzhou."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dez paisagens do Lago Ocidental inspiraram poetas por mil anos. Calçadas com salgueiros, lagoas de lotus e pagodes na névoa — um passeio de barco ou à beira da água é o ritual perfeito de Hangzhou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Десять знаменитых видов Западного озера вдохновляли поэтов тысячу лет. Ивовые дамбы, пруды с лотосами и пагоды в тумане — лодка или прогулка у воды — главный ритуал Ханчжоу."
          }
        }
      }
    },
    "journey.attraction.hz-a1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "West Lake"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lago del Oeste"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lago Ocidental"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Западное озеро"
          }
        }
      }
    },
    "journey.attraction.hz-a1.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rent a bike and loop the lake — the flat 15-km path takes about two hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alquila una bici y recorre el lago: el circuito plano de 15 km lleva unas dos horas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alugue uma bicicleta e faça o circuito do lago — o trajeto plano de 15 km leva cerca de duas horas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Арендуйте велосипед и объедьте озеро — плоский 15-км маршрут займёт около двух часов."
          }
        }
      }
    },
    "journey.attraction.hz-a2.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legendary tower overlooking the lake."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torre legendaria con vistas al lago."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torre lendária com vista para o lago."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Легендарная башня с видом на озеро."
          }
        }
      }
    },
    "journey.attraction.hz-a2.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Leifeng Pagoda legend tells of a white snake spirit imprisoned beneath its foundations. Rebuilt in 2002, the tower offers panoramic West Lake views from its summit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La leyenda cuenta que un espíritu de serpiente blanca quedó aprisionado bajo sus cimientos. Reconstruida en 2002, la torre ofrece vistas panorámicas del Lago del Oeste desde su cima."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lenda diz que um espírito de cobra branca ficou preso sob suas fundações. Reconstruída em 2002, a torre oferece vista panorâmica do Lago Ocidental do topo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Легенда гласит, что под основанием пагоды Лэйфэн заточён дух белой змеи. Перестроенная в 2002 году, башня открывает панораму Западного озера с верхней смотровой."
          }
        }
      }
    },
    "journey.attraction.hz-a2.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leifeng Pagoda"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagoda Leifeng"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagode Leifeng"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пагода Лэйфэн"
          }
        }
      }
    },
    "journey.attraction.hz-a2.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Climb at sunset for golden light on the lake and pagoda silhouettes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube al atardecer para luz dorada sobre el lago y siluetas de pagodas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suba ao pôr do sol para luz dourada no lago e silhuetas de pagodes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поднимитесь на закате — золотой свет на озере и силуэты пагод."
          }
        }
      }
    },
    "journey.attraction.hz-a3.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rolling hills of Longjing tea bushes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colinas cubiertas de arbustos de té Longjing."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colinas cobertas por arbustos de chá Longjing."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Холмы, покрытые кустами чая лунцзин."
          }
        }
      }
    },
    "journey.attraction.hz-a3.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hills of Meijiawu and Longjing village grow China's most prized green tea. Walk between rows of tea bushes, watch hand-picking in spring, and taste fresh Longjing brewed on the spot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las colinas de Meijiawu y la aldea Longjing cultivan el té verde más apreciado de China. Camina entre filas de arbustos, observa la recolección manual en primavera y prueba Longjing recién infusionado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As colinas de Meijiawu e a aldeia Longjing cultivam o chá verde mais valorizado da China. Caminhe entre fileiras de arbustos, veja a colheita manual na primavera e prove Longjing fresco infundido ali."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На холмах Мейцзяу и в деревне Лунцзин выращивают самый ценный зелёный чай Китая. Идите между рядами кустов, смотрите ручной сбор весной и пробуйте лунцзин, заваренный на месте."
          }
        }
      }
    },
    "journey.attraction.hz-a3.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tea Plantations"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plantaciones de té"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plantações de chá"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чайные плантации"
          }
        }
      }
    },
    "journey.attraction.hz-a3.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visit in April during the spring harvest — pickers are busiest and tea is freshest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visita en abril durante la cosecha de primavera: más recolectores y té más fresco."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visite em abril durante a colheita de primavera — mais colhedores e chá mais fresco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приезжайте в апреле на весенний сбор — сборщики в деле, чай самый свежий."
          }
        }
      }
    },
    "journey.attraction.hz-a4.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancient Buddhist temple in forested hills."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antiguo templo budista entre colinas boscosas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antigo templo budista entre colinas arborizadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Древний буддийский храм среди лесистых холмов."
          }
        }
      }
    },
    "journey.attraction.hz-a4.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Founded in 326 AD, Lingyin Temple sits in a forested valley with Feilai Peak's rock carvings nearby. Giant camphor trees shade the courtyards, and incense smoke drifts through ancient halls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fundado en el 326 d.C., el templo Lingyin se alza en un valle boscoso junto a las tallas de la cima Feilai. Gigantescos alcanfores sombrean los patios y el humo de incienso recorre salones antiguos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fundado em 326 d.C., o templo Lingyin fica em um vale arborizado, perto das esculturas do pico Feilai. Gigantescos cânforas sombreiam os pátios e fumaça de incenso percorre salões antigos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Основанный в 326 году, храм Линъинь стоит в лесной долине, рядом — скальные изваяния пика Фэйлай. Гигантские камфорные деревья затеняют дворы, а дым благовоний вьётся в древних залах."
          }
        }
      }
    },
    "journey.attraction.hz-a4.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingyin Temple"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Templo Lingyin"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Templo Lingyin"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храм Линъинь"
          }
        }
      }
    },
    "journey.attraction.hz-a4.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walk the Feilai Peak trail first — the rock grottoes are quieter in the morning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorre primero el sendero de Feilai Peak: las grutas están más tranquilas por la mañana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caminhe primeiro na trilha do pico Feilai — as grutas nas rochas são mais tranquilas de manhã."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала пройдите тропу на пик Фэйлай — скальные гроты утром тише."
          }
        }
      }
    },
    "journey.attraction.hz-a5.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hangzhou's modern skyline along the Qiantang River."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El horizonte moderno de Hangzhou junto al río Qiantang."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O horizonte moderno de Hangzhou às margens do rio Qiantang."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Современная панорама Ханчжоу вдоль реки Цяньтан."
          }
        }
      }
    },
    "journey.attraction.hz-a5.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qianjiang New Town showcases Hangzhou's tech-driven future with the golden International Conference Center and wave-shaped Civic Center. The riverside light show on weekends draws crowds from across the city."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qianjiang New Town muestra el futuro tecnológico de Hangzhou con el dorado Centro de Conferencias Internacional y el Civic Center de forma de ola. El show de luces junto al río los fines de semana atrae multitudes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qianjiang New Town mostra o futuro tecnológico de Hangzhou com o dourado Centro Internacional de Conferências e o Civic Center em forma de onda. O show de luzes à beira do rio nos fins de semana atrai multidões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новый район Цяньцзян демонстрирует технологическое будущее Ханчжоу: золотой Международный конференц-центр и волнистый Гражданский центр. По выходным световое шоу на набережной собирает толпы."
          }
        }
      }
    },
    "journey.attraction.hz-a5.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qianjiang CBD"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CBD de Qianjiang"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CBD de Qianjiang"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деловой центр Цяньцзян"
          }
        }
      }
    },
    "journey.attraction.hz-a5.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch the Qiantang River light show on Friday or Saturday evenings from the waterfront."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve el show de luces del río Qiantang los viernes o sábados desde el paseo marítimo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja o show de luzes do rio Qiantang nas sextas ou sábados à noite da orla."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрите световое шоу на реке Цяньтан в пятницу или субботу с набережной."
          }
        }
      }
    },
    "journey.attraction.read_more" : {
      "extractionState" : "manual",
      "localizations" : {
