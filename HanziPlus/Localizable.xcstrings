    "journey.city.chengdu.introduction" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pandas nap in the bamboo, tea houses hum with mahjong — Chengdu knows how to slow down."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pandas duermen entre bambúes y las casas de té suenan a mahjong: Chengdú sabe ir despacio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pandas cochilam no bambu e casas de chá vibram com mahjong — Chengdu sabe desacelerar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Панды дремлют в бамбуке, в чайных стучат костяшки маджонга — в Чэнду умеют не спешить."
          }
        }
