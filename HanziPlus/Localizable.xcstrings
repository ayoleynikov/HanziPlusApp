    "journey.city.shanghai.introduction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrive in Shanghai — where Art Deco heritage meets one of the world's most futuristic skylines."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добро пожаловать в Шанхай — где наследие ар-деко встречается с одним из самых футуристичных горизонтов мира."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llega a Shanghái: el patrimonio art déco se une a uno de los rascacielos más futuristas del mundo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chegue a Xangai — onde o legado art déco encontra um dos skylines mais futuristas do mundo."
          }
        }
      }
    },
