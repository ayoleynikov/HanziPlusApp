    "journey.city.suzhou.famousFor" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classical gardens, canal lanes, and silk embroidery"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jardines clásicos, calles junto a canales y bordado en seda"
