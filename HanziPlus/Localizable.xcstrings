    "journey.city.chengdu.introduction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to Chengdu — relaxed tea-house culture and homeland of the giant panda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добро пожаловать в Чэнду — спокойную культуру чайных домов и родину большой панды."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenido a Chengdú: cultura de casas de té y tierra del panda gigante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindo a Chengdu — cultura descontraída das casas de chá e terra do panda-gigante."
          }
        }
      }
    },
