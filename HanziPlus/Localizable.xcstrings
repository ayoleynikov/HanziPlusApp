    "journey.attraction.xa-a5.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The park recreates Chang'an, the Tang capital, with palaces, lakes, and costumed performances. After dark, millions of LEDs turn the grounds into a glowing open-air stage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recrea Chang'an, capital Tang, con palacios, lagos y espectáculos con trajes. Al anochecer, millones de LED convierten el parque en un escenario luminoso al aire libre."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recria Chang'an, capital Tang, com palácios, lagos e apresentações com trajes. Ao anoitecer, milhões de LEDs transformam o parque em um palco luminoso ao ar livre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Парк воссоздаёт столицу Тан — Чанъань: дворцы, озёра, представления в костюмах. После заката миллионы светодиодов превращают его в светящуюся сцену под открытым небом."
          }
        }
      }
    },
