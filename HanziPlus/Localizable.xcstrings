    "journey.fact.bj1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Forbidden City has nearly 9,000 rooms — yet no one knows the exact count."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Ciudad Prohibida tiene casi 9000 habitaciones, pero nadie sabe el número exacto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Cidade Proibida tem quase 9 mil cômodos — ninguém sabe a contagem exata."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В Запретном городе почти 9 000 комнат — точное число до сих пор неизвестно."
          }
        }
      }
    },
    "journey.fact.bj2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Great Wall would stretch from Beijing to Paris if laid in a straight line."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la Gran Muralla fuera recta, llegaría de Pekín a París."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a Grande Muralha fosse reta, iria de Pequim a Paris."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вытянуть Великую стену в линию, она дотянется от Пекина до Парижа."
          }
        }
      }
    },
    "journey.fact.bj3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beijing opera performers train for years before painting their first face mask."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los artistas de la ópera de Pekín entrenan años antes de pintar su primera máscara."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artistas da ópera de Pequim treinam anos antes de pintar a primeira máscara."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Артисты пекинской оперы годами учатся, прежде чем нанести первую маску."
          }
        }
      }
    },
    "journey.fact.cd1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giant pandas spend up to 14 hours a day eating bamboo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pandas gigantes pasan hasta 14 horas al día comiendo bambú."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pandas-gigantes passam até 14 horas por dia comendo bambu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Большие панды могут есть бамбук до 14 часов в сутки."
          }
        }
      }
    },
    "journey.fact.cd2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A single Chengdu tea house can host mahjong games that last an entire afternoon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En una casa de té de Chengdú el mahjong puede durar toda la tarde."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numa casa de chá de Chengdu o mahjong pode durar a tarde inteira."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В одной чайной Чэнду маджонг иногда играют целый день без перерыва."
          }
        }
      }
    },
    "journey.fact.cd3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichuan pepper numbs your tongue before the chili heat kicks in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pimienta de Sichuan adormece la lengua antes de que llegue el picante del chile."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pimenta de Sichuan adormece a língua antes do ardor do chili."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сычуаньский перец сначала онемляет язык, а уже потом приходит жгучая острота."
          }
        }
      }
    },
    "journey.fact.gl1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An ancient proverb calls Guilin's scenery the finest under heaven."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un antiguo proverbio llama a los paisajes de Guilin los mejores bajo el cielo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um provérbio antigo chama a paisagem de Guilin a melhor sob o céu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Древняя пословица называет пейзажи Гуйлиня лучшими под небесами."
          }
        }
      }
    },
    "journey.fact.gl2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The view on China's 20-yuan note is a real spot on the Li River."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El paisaje del billete de 20 yuanes es un lugar real del río Li."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A paisagem da nota de 20 yuans é um ponto real no rio Li."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пейзаж с купюры в 20 юаней — реальный вид на реке Ли."
          }
        }
      }
    },
    "journey.fact.gl3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photographers camp on Xianggong Hill for sunrise shots over the karst peaks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotógrafos acampan en la colina Xianggong para captar el amanecer sobre los picos kársticos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotógrafos acampam na colina Xianggong para registrar o nascer do sol sobre os picos cársticos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фотографы ночуют на холме Сяньгун, чтобы снять рассвет над карстами."
          }
        }
      }
    },
    "journey.fact.gy1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guiyang is nicknamed China's \"forest city\" — parks cover much of the urban core."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guiyang es la «ciudad forestal» de China: los parques cubren gran parte del centro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guiyang é a «cidade-floresta» da China — parques cobrem boa parte do centro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гуйян называют «лесным городом» — парки занимают большую часть центра."
          }
        }
      }
    },
    "journey.fact.gy2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huangguoshu Waterfall near Guiyang is wider than Niagara Falls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cascada Huangguoshu, cerca de Guiyang, es más ancha que las Cataratas del Niágara."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cachoeira Huangguoshu, perto de Guiyang, é mais larga que as Cataratas do Niágara."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Водопад Хуангошу у Гуйяна шире Ниагары."
          }
        }
      }
    },
    "journey.fact.gy3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Over 40 ethnic groups live in Guizhou — more than any other Chinese province."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más de 40 grupos étnicos viven en Guizhou, más que en cualquier otra provincia china."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais de 40 grupos étnicos vivem em Guizhou — mais do que em qualquer outra província chinesa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В Гуйчжоу проживает более 40 народов — больше, чем в любой другой провинции Китая."
          }
        }
      }
    },
    "journey.fact.gz1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yum cha in Guangzhou can mean an all-morning marathon of tea and dumplings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El yum cha en Cantón puede ser un maratón matutino de té y dumplings."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O yum cha em Guangzhou pode ser uma maratona matinal de chá e dumplings."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ямча в Гуанчжоу — это марафон чая и пельменей на всё утро."
          }
        }
      }
    },
    "journey.fact.gz2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canton Tower's twisted shape was inspired by a slender goddess from local legend."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La forma retorcida de la Torre de Cantón se inspiró en una diosa esbelta de la leyenda local."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O formato torcido da Torre de Cantão veio de uma deusa esguia da lenda local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Форму Canton Tower вдохновила легенда о стройной богине."
          }
        }
      }
    },
    "journey.fact.gz3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangzhou has traded with the world for over 2,000 years."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cantón ha comerciado con el mundo durante más de 2000 años."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangzhou comercia com o mundo há mais de 2 mil anos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гуанчжоу торгует с миром уже более двух тысяч лет."
          }
        }
      }
    },
    "journey.fact.hb1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harbin's Ice Festival carves over 200,000 cubic meters of ice each winter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Festival del Hielo de Harbin talla más de 200 000 m³ de hielo cada invierno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Festival do Gelo de Harbin esculpe mais de 200 mil m³ de gelo todo inverno."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На Ледовом фестивале Харбина каждую зиму используют более 200 000 м³ льда."
          }
        }
      }
    },
    "journey.fact.hb2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Central Street's cobblestones were imported from Russia over a century ago."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los adoquines de la Calle Central se importaron de Rusia hace más de un siglo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os paralelepípedos da Rua Central foram importados da Rússia há mais de um século."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Брусчатку Центральной улицы привезли из России больше ста лет назад."
          }
        }
      }
    },
    "journey.fact.hb3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harbin hosts the world's largest ice and snow sculpture festival."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harbin acoge el festival de esculturas de hielo y nieve más grande del mundo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harbin sedeia o maior festival de esculturas de gelo e neve do mundo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В Харбине проходит крупнейший в мире фестиваль ледяных и снежных скульптур."
          }
        }
      }
    },
    "journey.fact.hk1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Peak Tram has climbed Victoria Peak since 1888 — one of the world's oldest funiculars."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Peak Tram sube al Pico Victoria desde 1888, uno de los funiculares más antiguos del mundo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Peak Tram sobe ao Pico Victoria desde 1888 — um dos funiculares mais antigos do mundo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фуникулёр Peak Tram поднимается на пик Виктория с 1888 года — один из старейших в мире."
          }
        }
      }
    },
    "journey.fact.hk2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Star Ferry ride costs less than a cup of coffee but delivers the best harbor view."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un viaje en Star Ferry cuesta menos que un café y ofrece la mejor vista del puerto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma viagem no Star Ferry custa menos que um café e traz a melhor vista do porto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поездка на Star Ferry стоит дешевле чашки кофе, а вид на гавань — лучший в городе."
          }
        }
      }
    },
    "journey.fact.hk3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hong Kong packs more skyscrapers than New York and Tokyo combined."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hong Kong tiene más rascacielos que Nueva York y Tokio juntas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hong Kong tem mais arranha-céus do que Nova York e Tóquio juntas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В Гонконге больше небоскрёбов, чем в Нью-Йорке и Токио вместе взятых."
          }
        }
      }
    },
    "journey.fact.hz1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emperor Qianlong once declared Longjing tea the finest in all of China."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El emperador Qianlong declaró el té Longjing el mejor de toda China."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O imperador Qianlong declarou o chá Longjing o melhor de toda a China."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Император Цяньлун когда-то назвал чай лунцзин лучшим во всём Китае."
          }
        }
      }
    },
    "journey.fact.hz2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "West Lake has ten officially named scenic spots — poets named most of them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Lago del Oeste tiene diez miradores oficiales, la mayoría bautizados por poetas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Lago Ocidental tem dez mirantes oficiais — a maioria nomeada por poetas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У Западного озера десять официальных «живописных мест» — большинство назвали поэты."
          }
        }
      }
    },
    "journey.fact.hz3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marco Polo called Hangzhou the finest and noblest city in the world."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marco Polo llamó a Hangzhou la ciudad más espléndida y noble del mundo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marco Polo chamou Hangzhou a cidade mais esplêndida e nobre do mundo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Марко Поло называл Ханчжоу «прекраснейшим и благороднейшим городом мира»."
          }
        }
      }
    },
    "journey.fact.sh1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shanghai's maglev hits 431 km/h — faster than most Formula 1 cars."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El maglev de Shanghái alcanza 431 km/h, más rápido que la mayoría de los Fórmula 1."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O maglev de Xangai chega a 431 km/h — mais rápido que a maioria dos carros de Fórmula 1."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шанхайский maglev разгоняется до 431 км/ч — быстрее большинства болидов «Формулы-1»."
          }
        }
      }
    },
    "journey.fact.sh2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Bund packs 52 buildings spanning Gothic, Baroque, and Art Deco styles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Bund concentra 52 edificios de estilos gótico, barroco y art déco."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Bund reúne 52 edifícios em estilos gótico, barroco e art déco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На Бунде 52 здания в готическом, барокко и ар-деко стилях."
          }
        }
      }
    },
    "journey.fact.sh3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Huangpu River cruise at night turns both banks into a wall of light."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un crucero nocturno por el Huangpu convierte ambas orillas en un muro de luces."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um cruzeiro noturno pelo Huangpu transforma as duas margens em um muro de luzes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ночной круиз по Хуанпу превращает оба берега в стену огней."
          }
        }
      }
    },
    "journey.fact.sz1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suzhou's Humble Administrator's Garden took 16 years to build in the 1500s."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Jardín del Administrador Humilde tardó 16 años en construirse en el siglo XVI."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Jardim do Administrador Humilde levou 16 anos para ser construído, no século XVI."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сад скромного чиновника строили шестнадцать лет — в XVI веке."
          }
        }
      }
    },
    "journey.fact.sz2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One Suzhou silk embroidery piece can take an artisan over a year to finish."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un solo bordado de seda de Suzhou puede llevar más de un año a un artesano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma peça de bordado em seda de Suzhou pode levar mais de um ano a um artesão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одна шёлковая вышивка Сучжоу может занимать мастера больше года."
          }
        }
      }
    },
    "journey.fact.sz3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suzhou's old canals earned it the nickname Venice of the East."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los antiguos canales de Suzhou le valieron el apodo de Venecia de Oriente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os canais antigos de Suzhou renderam o apelido de Veneza do Oriente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Старые каналы Сучжоу принесли ему прозвище «Восточная Венеция»."
          }
        }
      }
    },
    "journey.fact.szh1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shenzhen produces roughly 90% of the world's consumer electronics."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shenzhen produce cerca del 90% de la electrónica de consumo del mundo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shenzhen produz cerca de 90% da eletrônica de consumo do mundo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шэньчжэнь производит около 90% мировой потребительской электроники."
          }
        }
      }
    },
    "journey.fact.szh2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nearly half of Shenzhen is green space — parks, wetlands, and coastal trails."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casi la mitad de Shenzhen es espacio verde: parques, humedales y senderos costeros."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quase metade de Shenzhen é área verde — parques, pântanos e trilhas litorâneas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почти половина Шэньчжэня — зелёные зоны: парки, болота и прибрежные тропы."
          }
        }
      }
    },
    "journey.fact.szh3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shenzhen went from 30,000 residents in 1980 to a megacity of 18 million."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shenzhen pasó de 30 000 habitantes en 1980 a una megaciudad de 18 millones."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shenzhen saltou de 30 mil habitantes em 1980 para uma megacidade de 18 milhões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С 1980 года Шэньчжэнь вырос с 30 000 жителей до мегаполиса на 18 миллионов."
          }
        }
      }
    },
    "journey.fact.xa1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every Terracotta Warrior has a unique face — no two are alike."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada guerrero de terracota tiene un rostro único: no hay dos iguales."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada guerreiro de terracota tem um rosto único — não há dois iguais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У каждого терракотового воина своё лицо — двух одинаковых не найти."
          }
        }
      }
    },
    "journey.fact.xa2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silk caravans once left Xi'an carrying spices west and gold east."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caravanas de seda salían de Xi'an con especias al oeste y oro al este."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caravanas de seda saíam de Xi'an com especiarias a oeste e ouro a leste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсюда когда-то уходили караваны со специями на запад и золотом на восток."
          }
        }
      }
    },
    "journey.fact.xa3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can still cycle the full 14 km atop Xi'an's Ming-era city wall."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún puedes recorrer en bici los 14 km completos sobre la muralla Ming de Xi'an."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda dá para pedalar os 14 km inteiros sobre a muralha Ming de Xi'an."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По стене Сианя эпохи Мин до сих пор можно проехать на велосипеде все 14 км."
          }
        }
      }
    },
