            "value" : "Харбинский оперный театр"
          }
        }
      }
    },
    "journey.attraction.hb-a5.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Book a backstage tour on weekdays — the architecture is even more dramatic from inside."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reserva un tour entre bastidores entre semana: la arquitectura es más dramática desde dentro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reserve um tour nos bastidores em dias úteis — a arquitetura é mais dramática por dentro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закажите экскурсию за сценой в будни — архитектура изнутри ещё эффектнее."
          }
        }
      }
    },
    "journey.attraction.hk-a1.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panoramic views over the harbor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vistas panorámicas del puerto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vista panorâmica do porto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Панорамные виды на гавань."
          }
        }
      }
    },
    "journey.attraction.hk-a1.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Victoria Peak rises 552 meters above Hong Kong Island, offering the city's most famous skyline view. The Peak Tram climbs steeply through jungle, and the Sky Terrace 428 overlooks the harbor, Kowloon, and distant islands."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Pico Victoria se eleva 552 metros sobre la isla de Hong Kong con la vista más famosa del horizonte. El Peak Tram asciende empinado entre la jungla, y el Sky Terrace 428 domina el puerto, Kowloon y las islas lejanas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Pico Victoria se eleva 552 metros sobre a ilha de Hong Kong com a vista mais famosa do horizonte. O Peak Tram sobe íngreme pela selva, e o Sky Terrace 428 domina o porto, Kowloon e ilhas distantes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пик Виктория поднимается 552 метра над островом Гонконг — самый знаменитый вид на панораму города. Фуникулёр Peak Tram круто поднимается через джунгли, а Sky Terrace 428 смотрит на гавань, Коулун и далёкие острова."
          }
        }
      }
    },
    "journey.attraction.hk-a1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Victoria Peak"
          }
        },
        "es" : {
          "stringUnit" : {
