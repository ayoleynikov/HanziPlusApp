    "journey.attraction.bj-a1.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Ming-Qing imperial palace with nearly 9,000 rooms."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palacio imperial Ming-Qing con casi 9000 habitaciones."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palácio imperial Ming-Qing com quase 9 mil cômodos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Императорский дворец эпох Мин и Цин с почти 9 000 комнатами."
          }
        }
      }
    },
    "journey.attraction.bj-a1.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twenty-four emperors ruled from these vermilion walls. Walk the central axis through throne halls and side courtyards where court rituals once played out daily."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veinticuatro emperadores gobernaron desde estos muros bermellón. Recorre el eje central entre salones del trono y patios donde los rituales de corte se repetían cada día."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinte e quatro imperadores governaram a partir destes muros vermelhos. Siga o eixo central pelos salões do trono e pátios onde rituais de corte aconteciam todos os dias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсюда правили двадцать четверо императоров. Пройдите по центральной оси через тронные залы и боковые дворики, где когда-то ежедневно шли придворные церемонии."
          }
        }
      }
    },
    "journey.attraction.bj-a1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbidden City"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciudad Prohibida"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cidade Proibida"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запретный город"
          }
        }
      }
    },
    "journey.attraction.bj-a1.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter from Tiananmen West early to skip the longest queues."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entra por Tiananmen Oeste temprano para evitar las colas más largas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre pelo Tiananmen Oeste cedo para evitar as filas mais longas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заходите с западной стороны Тяньаньмэнь рано утром — очереди короче."
          }
        }
      }
    },
    "journey.attraction.bj-a2.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancient fortifications snaking across mountain ridges."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antiguas fortificaciones serpenteando por las crestas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antigas fortificações serpenteando pelas cristas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Древние укрепления, извивающиеся по горным хребтам."
          }
        }
      }
    },
    "journey.attraction.bj-a2.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mutianyu and Badaling are the easiest sections from Beijing. Watchtowers climb ridge after ridge — autumn foliage and spring blossoms make the most photogenic seasons."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mutianyu y Badaling son las secciones más accesibles desde Pekín. Torres de vigilancia suben cresta tras cresta; el follaje otoñal y la floración primaveral son ideales para fotos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mutianyu e Badaling são os trechos mais acessíveis a partir de Pequim. Torres de vigia sobem crista após crista; folhagem de outono e flores na primavera são ótimas para fotos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мутяньюй и Бадалин — самые доступные участки от Пекина. Сторожевые башни тянутся по гребням; осенняя листва и весеннее цветение — лучшее время для фото."
          }
        }
      }
    },
    "journey.attraction.bj-a2.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Great Wall"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gran Muralla"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grande Muralha"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Великая стена"
          }
        }
      }
    },
    "journey.attraction.bj-a2.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visit Mutianyu on a weekday morning for shorter cable-car lines."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visita Mutianyu entre semana por la mañana para colas más cortas en el teleférico."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visite Mutianyu numa manhã de dia útil para filas menores no teleférico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Езжайте в Мутяньюй в будний день утром — очереди на канатку короче."
          }
        }
      }
    },
    "journey.attraction.bj-a3.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where emperors prayed for good harvests under a circular blue roof."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donde los emperadores rezaban por buenas cosechas bajo un techo azul circular."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde imperadores rezavam por boas colheitas sob um teto azul circular."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Место, где императоры молились об урожае под круглой синей крышей."
          }
        }
      }
    },
    "journey.attraction.bj-a3.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Hall of Prayer for Good Harvests is a masterpiece of Ming architecture — no nails, only timber joinery. The surrounding park fills with tai chi, erhu, and ballroom dancing at dawn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Salón de Oración por Buenas Cosechas es una obra maestra Ming sin un solo clavo. Al amanecer el parque se llena de tai chi, erhu y bailes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Salão de Oração por Boas Colheitas é uma obra-prima Ming sem um único prego. Ao amanhecer o parque enche de tai chi, erhu e dança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зал молитв об урожае — шедевр архитектуры Мин без единого гвоздя. Вокруг на рассвете занимаются тайцзи, играют на эру и танцуют."
          }
        }
      }
    },
    "journey.attraction.bj-a3.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temple of Heaven"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Templo del Cielo"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Templo do Céu"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храм Неба"
          }
        }
      }
    },
    "journey.attraction.bj-a3.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrive at opening time to watch locals practice tai chi in the park."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llega a la hora de apertura para ver tai chi en el parque."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chegue na abertura para ver moradores praticando tai chi no parque."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приходите к открытию — увидите, как местные занимаются тайцзи."
          }
        }
      }
    },
    "journey.attraction.bj-a4.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crispy skin, tender meat — Beijing's most famous dish."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piel crujiente y carne tierna: el plato más famoso de Pekín."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pele crocante e carne macia — o prato mais famoso de Pequim."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хрустящая корочка и нежное мясо — главное блюдо Пекина."
          }
        }
      }
    },
    "journey.attraction.bj-a4.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A skilled chef slices the duck tableside in under two minutes. Wrap shards of crispy skin in thin pancakes with scallion and sweet bean sauce — the ritual matters as much as the taste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un chef experto filetea el pato en la mesa en menos de dos minutos. Envuelve piel crujiente en panqueques finos con cebolleta y salsa dulce: el ritual importa tanto como el sabor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um chef habilidoso fatia o pato à mesa em menos de dois minutos. Enrola a pele crocante em panquecas finas com cebolinha e molho doce — o ritual importa tanto quanto o sabor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повар нарезает утку за столом меньше чем за две минуты. Заверните хрустящую корочку в тонкий блин с зелёным луком и сладким соусом — ритуал не менее важен, чем вкус."
          }
        }
      }
    },
    "journey.attraction.bj-a4.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peking Duck"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pato pekinés"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pato à pequinesa"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утка по-пекински"
          }
        }
      }
    },
    "journey.attraction.bj-a4.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Book a table at a famous roast-duck restaurant at least a day ahead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reserva mesa en un restaurante famoso de pato al menos un día antes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reserve mesa em um restaurante famoso de pato com pelo menos um dia de antecedência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бронируйте стол в известной утиной хотя бы за день."
          }
        }
      }
    },
    "journey.attraction.bj-a5.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Former factory yards now packed with galleries and street art."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antiguos patios fabriles convertidos en galerías y arte callejero."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antigos pátios de fábrica transformados em galerias e arte de rua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бывшие заводские дворы, превращённые в галереи и уличное искусство."
          }
        }
      }
    },
    "journey.attraction.bj-a5.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Red-brick Bauhaus workshops from the 1950s now host contemporary art, design shops, and weekend markets. Murals cover entire walls, and indie cafés fill the courtyards between shows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talleres de ladrillo rojo de los años 50 albergan arte contemporáneo, diseño y mercados de fin de semana. Muros enteros son murales y los patios se llenan de cafés independientes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oficinas de tijolo vermelho dos anos 50 abrigam arte contemporânea, design e feiras de fim de semana. Muros inteiros viram murais e os pátios enchem de cafés independentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Краснокирпичные цеха 1950-х годов стали галереями, дизайнерскими магазинами и рынками по выходным. Стены покрыты муралами, а дворики заполнены кофейнями."
          }
        }
      }
    },
    "journey.attraction.bj-a5.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "798 Art District"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distrito artístico 798"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distrito artístico 798"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Арт-квартал 798"
          }
        }
      }
    },
    "journey.attraction.bj-a5.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weekday mornings are quietest; weekends bring pop-up markets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las mañanas entre semana son más tranquilas; los fines de semana hay mercados."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manhãs de dias úteis são mais tranquilas; nos fins de semana há feiras."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В будни утром тише всего; по выходным бывают ярмарки."
          }
        }
      }
    },
    "journey.attraction.cd-a1.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch giant pandas munch bamboo just meters away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observa pandas gigantes masticando bambú a pocos metros."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja pandas-gigantes mastigando bambu a poucos metros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрите, как большие панды жуют бамбук в нескольких метрах от вас."
          }
        }
      }
    },
    "journey.attraction.cd-a1.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Chengdu Research Base opens early when pandas are most active. Red pandas share the trails, and the nursery lets you peek at cubs during breeding season."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base abre temprano, cuando los pandas están más activos. Pandas rojos comparten senderos y en temporada de cría puedes ver cachorros en el vivero."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A base abre cedo, quando os pandas estão mais ativos. Pandas-vermelhos compartilham trilhas e na temporada de reprodução dá para ver filhotes no berçário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "База открывается рано — панды наиболее активны утром. Красных панд можно встретить на тропах, а в сезон размножения в питомнике видны малыши."
          }
        }
      }
    },
    "journey.attraction.cd-a1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panda Base"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Base de pandas"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Base de pandas"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "База больших панд"
          }
        }
      }
    },
    "journey.attraction.cd-a1.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrive at 7:30 AM opening — pandas feed then and nap by noon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llega a la apertura a las 7:30: comen por la mañana y duermen al mediodía."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chegue na abertura às 7:30 — eles comem de manhã e cochilam ao meio-dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приезжайте к открытию в 7:30 — панды кормят утром и дремлют к полудню."
          }
        }
      }
    },
    "journey.attraction.cd-a2.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lantern-lit lane of snacks, crafts, and Sichuan opera."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calle iluminada con farolillos, bocadillos, artesanía y ópera de Sichuan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rua iluminada por lanternas, petiscos, artesanato e ópera de Sichuan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Улица с фонарями, закусками, ремёслами и сычуаньской оперой."
          }
        }
      }
    },
    "journey.attraction.cd-a2.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This restored Qing-era street glows red at night with snack stalls and sugar paintings. Street performers and shadow-puppet shows keep the crowd moving until midnight."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta calle Qing restaurada brilla de rojo de noche con puestos y figuras de azúcar. Artistas callejeros y teatro de sombras animan la multitud hasta medianoche."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta rua Qing restaurada brilha vermelha à noite com barracas e figuras de açúcar. Artistas de rua e teatro de sombras animam a multidão até meia-noite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановленная улица эпохи Цин ночью светится красным: ларьки с закусками и сахарные фигурки. Уличные артисты и теневой театр не дают заскучать до полуночи."
          }
        }
      }
    },
    "journey.attraction.cd-a2.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
