          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Музей шёлка"
          }
        }
      }
    },
    "journey.attraction.sz-a4.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch the silkworm feeding demo in the cultivation room — kids love it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve la demostración de alimentación de gusanos de seda: a los niños les encanta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja a demonstração de alimentação dos bichos-da-seda — os filhos adoram."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посмотрите демонстрацию кормления шелкопрядов — детям особенно интересно."
          }
        }
      }
    },
    "journey.attraction.sz-a5.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modern lakefront with skyline views and night lights."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orilla moderna con vistas al horizonte y luces nocturnas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orla moderna com vista para o horizonte e luzes noturnas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Современная набережная с панорамой и ночной подсветкой."
          }
        }
      }
    },
    "journey.attraction.sz-a5.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jinji Lake is Suzhou's modern centerpiece — an artificial lake surrounded by the Suzhou Center mall, Ferris wheel, and waterfront promenades. Evening light shows and open-air concerts fill the lakeside calendar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Lago Jinji es el centro moderno de Suzhou: un lago artificial rodeado del Suzhou Center, una noria y paseos marítimos. Shows de luces y conciertos al aire libre llenan el calendario junto al agua."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Lago Jinji é o centro moderno de Suzhou — um lago artificial cercado pelo Suzhou Center, roda-gigante e calçadões. Shows de luzes e concertos ao ar livre lotam o calendário à beira da água."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Озеро Цзиньцзи — современный центр Сучжоу: искусственное озеро вокруг торгового центра Suzhou Center, колеса обозрения и набережных. Вечерние световые шоу и концерты заполняют календарь у воды."
          }
        }
      }
    },
    "journey.attraction.sz-a5.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jinji Lake"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lago Jinji"
          }
        },
        "pt-BR" : {
