    "journey.city.shenzhen.introduction" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forty years ago it was a fishing village — now Shenzhen builds the future before your eyes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace cuarenta años era un pueblo pesquero; hoy Shenzhen construye el futuro ante tus ojos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há quarenta anos era uma vila de pescadores — hoje Shenzhen constrói o futuro diante dos seus olhos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сорок лет назад здесь была рыбацкая деревня — сегодня Шэньчжэнь строит будущее на ваших глазах."
          }
        }
      }
    },
