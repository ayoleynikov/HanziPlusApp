    "journey.attraction.gl-a1.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bamboo raft through iconic karst scenery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paseo en balsa de bambú entre paisajes kársticos emblemáticos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passeio de jangada de bambu entre paisagens cársticas icônicas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Путешествие на бамбуковом плоту среди знаменитых карстовых пейзажей."
          }
        }
      }
    },
    "journey.attraction.gl-a1.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Li River cruise from Guilin to Yangshuo passes the landscape printed on China's 20-yuan note. Misty karst peaks, bamboo groves, and cormorant fishermen create a scene painters have chased for centuries."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El crucero de Guilin a Yangshuo pasa por el paisaje del billete de 20 yuanes. Picos kársticos entre la niebla, bambúes y pescadores con cormoranes: escena que pintores persiguieron siglos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cruzeiro de Guilin a Yangshuo passa pela paisagem da nota de 20 yuans. Picos cársticos na névoa, bambuzais e pescadores com corvos-marinhos — cena que pintores perseguiram por séculos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Круиз от Гуйлиня до Яншо проходит мимо пейзажа с купюры 20 юаней. Туманные карсты, бамбуковые рощи и рыбаки с бакланами — картина, которую художники ловили столетия."
          }
        }
      }
    },
    "journey.attraction.gl-a1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Li River"
          }
        },
        "es" : {
