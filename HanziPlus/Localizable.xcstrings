    "journey.attraction.cd-a5.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visit the temple courtyard first, then explore side alleys for local desserts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visita primero el patio del templo y luego callejones con postres locales."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visite primeiro o pátio do templo e depois becos com sobremesas locais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала загляните во двор храма, затем — в боковые улочки с десертами."
          }
        }
      }
    },
