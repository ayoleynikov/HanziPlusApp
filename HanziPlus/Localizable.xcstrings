        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добро пожаловать в Сиань — древнюю столицу тринадцати династий и ворота Шёлкового пути."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
