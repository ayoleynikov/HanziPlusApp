          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Centro Financeiro Ping An"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Финансовый центр Пинань"
          }
        }
      }
    },
    "journey.attraction.szh-a1.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visit the free Sky Lobby on weekday mornings — queues are shortest before 10 AM."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visita el Sky Lobby gratuito entre semana por la mañana: las colas son más cortas antes de las 10."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visite o Sky Lobby gratuito em dias úteis de manhã — as filas são menores antes das 10h."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загляните в бесплатное смотровое лобби в будни утром — очереди короче до 10:00."
          }
        }
      }
    },
    "journey.attraction.szh-a2.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A waterfront promenade with skyline and sunset views."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un paseo marítimo con vistas al horizonte y al atardecer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um calçadão à beira-mar com vista para o horizonte e o pôr do sol."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Набережная с видами на городской силуэт и закаты."
          }
        }
      }
    },
    "journey.attraction.szh-a2.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shenzhen Bay Park stretches 13 km along the waterfront with cycling paths, mangrove wetlands, and views of Hong Kong across the water. Sunset here paints the skyline gold as joggers and families fill the promenade."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shenzhen Bay Park se extiende 13 km junto al mar con rutas ciclistas, manglares y vistas de Hong Kong al otro lado. Al atardecer el horizonte se tiñe de oro mientras corredores y familias llenan el paseo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Shenzhen Bay Park se estende 13 km à beira-mar com ciclovias, manguezais e vista de Hong Kong do outro lado. Ao pôr do sol o horizonte fica dourado enquanto corredores e famílias lotam o calçadão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Парк залива Шэньчжэнь тянется 13 км вдоль набережной — велодорожки, мангровые болота и вид на Гонконг через воду. На закате панорама золотится, а набережную заполняют бегуны и семьи."
          }
        }
      }
    },
    "journey.attraction.szh-a2.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shenzhen Bay"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahía de Shenzhen"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baía de Shenzhen"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Залив Шэньчжэнь"
          }
        }
      }
    },
    "journey.attraction.szh-a2.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rent a bike at the park entrance and ride west toward the mangrove section at dusk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alquila una bici en la entrada y pedalea hacia el oeste hasta los manglares al atardecer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alugue uma bicicleta na entrada e pedale para oeste em direção aos manguezais ao pôr do sol."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Арендуйте велосипед у входа и катите на запад к мангровым болотам на закате."
          }
        }
      }
    },
    "journey.attraction.szh-a3.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A creative neighborhood filled with artists and galleries."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un barrio creativo lleno de artistas y galerías."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um bairro criativo repleto de artistas e galerias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Творческий квартал, полный художников и галерей."
          }
        }
      }
    },
    "journey.attraction.szh-a3.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dafen Village once produced over half the world's commercial oil paintings. Today hundreds of studios and galleries line the streets, where artists copy masterpieces or create custom portraits on the spot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dafen produjo en su día más de la mitad de las pinturas al óleo comerciales del mundo. Hoy cientos de estudios y galerías llenan las calles, donde artistas copian obras maestras o pintan retratos al instante."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dafen produziu mais da metade das pinturas a óleo comerciais do mundo. Hoje centenas de estúdios e galerias lotam as ruas, onde artistas copiam obras-primas ou pintam retratos sob encomenda ali mesmo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деревня Дафэнь когда-то производила более половины коммерческих картин маслом в мире. Сегодня сотни студий и галерей — художники копируют шедевры или рисуют портреты на заказ прямо на месте."
          }
        }
      }
