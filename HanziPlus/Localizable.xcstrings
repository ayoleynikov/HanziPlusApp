            "value" : "Rua Pingjiang"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Улица Пинцзян"
          }
        }
      }
    },
    "journey.attraction.sz-a3.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop at a canal-side teahouse for biluochun tea — Suzhou's signature green brew."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para en una casa de té junto al canal y prueba biluochun, el té verde emblemático de Suzhou."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pare em uma casa de chá à beira do canal e prove biluochun — o chá verde típico de Suzhou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загляните в чайную у канала — попробуйте билочунь, фирменный зелёный чай Сучжоу."
          }
        }
      }
    },
    "journey.attraction.sz-a4.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Centuries of silk weaving tradition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siglos de tradición en el tejido de la seda."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séculos de tradição na tecelagem da seda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Многовековые традиции шёлкового ткачества."
          }
        }
      }
    },
    "journey.attraction.sz-a4.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suzhou Silk Museum traces silk production from silkworm cocoons to finished embroidery. Live weaving demonstrations and a replica of an ancient silk loom show how Suzhou became China's silk capital."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Museo de la Seda de Suzhou recorre la producción desde los capullos hasta el bordado terminado. Demostraciones de tejido en vivo y una réplica de telar antiguo muestran cómo Suzhou se convirtió en capital de la seda."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Museu da Seda de Suzhou traça a produção dos casulos até o bordado final. Demonstrações de tecelagem ao vivo e uma réplica de tear antigo mostram como Suzhou virou capital da seda da China."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Музей шёлка Сучжоу прослеживает путь от коконов до готовой вышивки. Демонстрации ткачества и копия древнего станка показывают, как Сучжоу стал шёлковой столицей Китая."
          }
        }
      }
    },
    "journey.attraction.sz-a4.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silk Museum"
          }
        },
        "es" : {
