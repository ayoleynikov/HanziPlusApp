    "settings.privacy.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HanziPlus stores your progress, favorites, and game statistics locally on this device. No account is required and no data is sent to external servers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "HanziPlus хранит прогресс, избранное и игровую статистику локально на этом устройстве. Аккаунт не нужен, данные не отправляются на внешние серверы."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HanziPlus guarda tu progreso, favoritos y estadísticas de juegos localmente en este dispositivo. No se necesita cuenta y no se envían datos a servidores externos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O HanziPlus guarda seu progresso, favoritos e estatísticas de jogos localmente neste dispositivo. Não é necessária uma conta e nenhum dado é enviado a servidores externos."
          }
        }
      }
    },
