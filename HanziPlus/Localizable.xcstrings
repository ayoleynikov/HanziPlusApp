    },
    "journey.city.suzhou.introduction" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canals, classical gardens, and silk threads finer than hair — Suzhou is China's quiet masterpiece."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canales, jardines clásicos e hilos de seda más finos que un cabello: Suzhou es la obra maestra serena de China."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canais, jardins clássicos e fios de seda mais finos que cabelo — Suzhou é a obra-prima tranquila da China."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каналы, классические сады и шёлковые нити тоньше волоса — Сучжоу, тихий шедевр Китая."
          }
        }
      }
    },
