    "journey.city.harbin.introduction" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When winter hits −30°C, Harbin builds a city of ice — and the world shows up to stare."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el invierno baja a −30 °C, Harbin levanta una ciudad de hielo y el mundo acude a mirar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o inverno chega a −30 °C, Harbin ergue uma cidade de gelo — e o mundo vem ver."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда мороз опускается до −30 °C, Харбин строит город изо льда — и весь мир приезжает смотреть."
          }
        }
      }
    },
