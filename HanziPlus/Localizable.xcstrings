          "stringUnit" : {
            "state" : "translated",
            "value" : "Karst peaks rise from the Li River like a living scroll — no filter needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picos kársticos emergen del río Li como un pergamino vivo: no hace falta filtro."
