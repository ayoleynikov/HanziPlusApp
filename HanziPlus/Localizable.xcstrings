    },
    "journey.attraction.szh-a5.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the V&A partnership exhibitions — they rotate every few months and are top quality."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa las exposiciones en colaboración con el V&A: rotan cada pocos meses y son de gran calidad."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confira as exposições em parceria com o V&A — elas mudam a cada poucos meses e são de alta qualidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрите экспозиции совместно с V&A — они меняются каждые несколько месяцев и очень качественные."
          }
        }
      }
    },
    "journey.attraction.tip_fallback" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visit early morning or late afternoon for fewer crowds and softer light."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visita temprano por la mañana o al atardecer para evitar multitudes y disfrutar de mejor luz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visite cedo de manhã ou no fim da tarde para evitar multidões e aproveitar uma luz mais suave."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приходите рано утром или ближе к вечеру — меньше людей и мягче свет."
          }
        }
      }
    },
    "journey.attraction.tip_title" : {
