    "journey.city.hangzhou.introduction" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "West Lake shimmers at dawn, Longjing tea steams by noon — Hangzhou is poetry you can walk through."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Lago del Oeste brilla al amanecer y el té Longjing humea al mediodía: Hangzhou es poesía para caminar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Lago Ocidental brilha ao amanhecer e o chá Longjing fuma ao meio-dia — Hangzhou é poesia para caminhar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Западное озеро мерцает на рассвете, чай лунцзин парит к полудню — Ханчжоу похож на стихи, по которым можно гулять."
          }
        }
      }
    },
