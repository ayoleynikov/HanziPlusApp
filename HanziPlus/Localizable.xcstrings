    "journey.attraction.gl-a2.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yangshuo's West Street buzzes with cafés and live music, but the real magic is outside town. Cycle through rice paddies to Moon Hill or take a bamboo raft on the Yulong River."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Calle Oeste rebosa cafés y música en vivo, pero la magia está fuera del pueblo. Pedalea entre arrozales hasta Moon Hill o navega en balsa por el río Yulong."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Rua Oeste vibra com cafés e música ao vivo, mas a magia está fora da cidade. Pedale entre arrozais até Moon Hill ou faça um passeio de jangada no rio Yulong."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Улица Западная полна кафе и живой музыки, но главная магия — за городом. Прокатитесь по рисовым полям к Лунному холму или сплавьтесь на плоту по реке Юлун."
          }
        }
      }
    },
    "journey.attraction.gl-a2.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yangshuo"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yangshuo"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yangshuo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Яншо"
          }
        }
      }
    },
    "journey.attraction.gl-a2.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rent an electric bike and explore the Yulong River valley at your own pace."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alquila una bici eléctrica y explora el valle del río Yulong a tu ritmo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alugue uma bicicleta elétrica e explore o vale do rio Yulong no seu ritmo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Арендуйте электробайк и исследуйте долину реки Юлун в своём темпе."
          }
        }
      }
    },
    "journey.attraction.gl-a3.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illuminated limestone cavern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caverna de piedra caliza iluminada."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caverna de calcário iluminada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Известняковая пещера с красочной подсветкой."
          }
        }
      }
    },
    "journey.attraction.gl-a3.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Named for reeds once used to make flutes at the entrance, this 240-meter cave dazzles with colored lights on stalactites and stalagmites. Crystal Palace Hall is the showstopper chamber."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombrada por las cañas con que se hacían flautas en la entrada, esta cueva de 240 metros brilla con luces de colores en estalactitas y estalagmitas. El salón Crystal Palace es el gran final."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nomeada pelos juncos usados para flautas na entrada, esta caverna de 240 metros brilha com luzes coloridas em estalactites e estalagmites. O salão Crystal Palace é o destaque."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Названа по тростнику, из которого у входа делали флейты. Пещера 240 метров сияет цветной подсветкой на сталактитах и сталагмитах. Главная — зал «Хрустальный палец»."
          }
        }
      }
    },
    "journey.attraction.gl-a3.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reed Flute Cave"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cueva de la Flauta de Caña"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caverna da Flauta de Junco"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пещера Тростниковой флейты"
          }
        }
      }
    },
    "journey.attraction.gl-a3.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photography is allowed — bring a wide-angle lens for the cavern ceilings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se permite fotografiar: lleva un objetivo gran angular para los techos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografia é permitida — leve uma lente grande-angular para os tetos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фотографировать можно — возьмите широкоугольный объектив для сводов."
          }
        }
      }
    },
    "journey.attraction.gl-a4.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dragon's Backbone rice terraces."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrozales en terrazas de la Espina del Dragón."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terraços de arroz da Espinha do Dragão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рисовые террасы «Драконий хребет»."
          }
        }
      }
    },
    "journey.attraction.gl-a4.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carved into hillsides since the 13th century, the Longji terraces ripple like dragon scales across the mountains. Spring brings mirror-like water, autumn paints the fields gold."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talladas en laderas desde el siglo XIII, las terrazas de Longji se extienden como escamas de dragón. En primavera el agua refleja el cielo; en otoño los campos se tiñen de oro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talhados nas encostas desde o século XIII, os terraços de Longji se estendem como escamas de dragão. Na primavera a água reflete o céu; no outono os campos ficam dourados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вырубленные на склонах с XIII века, террасы Лунцзи стелются по горам, как чешуя дракона. Весной вода зеркалит небо, осенью поля золотятся."
          }
        }
      }
    },
    "journey.attraction.gl-a4.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longji Terraces"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terrazas de Longji"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terraços de Longji"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рисовые террасы Лунцзи"
          }
        }
      }
    },
    "journey.attraction.gl-a4.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stay overnight in a Zhuang or Yao village guesthouse for sunrise over the terraces."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pernocta en una casa rural zhuang o yao para ver el amanecer sobre las terrazas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pernoite em uma pousada de aldeia zhuang ou yao para o nascer do sol sobre os terraços."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переночуйте в гостевом доме деревни чжуан или яо — рассвет над террасами незабываем."
          }
        }
      }
    },
    "journey.attraction.gl-a5.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Night cruise through illuminated waterways in central Guilin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucero nocturno por canales iluminados del centro de Guilin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cruzeiro noturno pelos canais iluminados do centro de Guilin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ночной круиз по подсвечённым каналам центра Гуйлиня."
          }
        }
      }
    },
    "journey.attraction.gl-a5.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This urban waterway loop connects the Li and Peach Blossom rivers with four lakes via ancient bridges and pagodas. The evening boat tour lights up the shoreline like a floating lantern festival."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este circuito urbano une los ríos Li y Flor de Melocotón con cuatro lagos mediante puentes y pagodas antiguas. El crucero nocturno ilumina la orilla como un festival de farolillos flotante."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este circuito urbano liga os rios Li e Flor de Pêssego a quatro lagos por pontes e pagodes antigos. O cruzeiro noturno ilumina a margem como um festival de lanternas flutuante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Городской водный маршрут соединяет реки Ли и Персиковый цвет с четырьмя озёрами через древние мосты и пагоды. Вечерний круиз зажигает набережные, как плавучий фестиваль фонарей."
          }
        }
      }
    },
    "journey.attraction.gl-a5.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two Rivers & Four Lakes"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos ríos y cuatro lagos"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dois rios e quatro lagos"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Два реки и четыре озёра"
          }
        }
      }
    },
    "journey.attraction.gl-a5.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Book the last evening boat for the fullest light show on the bridges."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reserva el último barco de la noche para el show de luces más completo en los puentes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reserve o último barco da noite para o show de luzes mais completo nas pontes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Берите последний вечерний круиз — на мостах самая яркая световая программа."
          }
        }
      }
    },
    "journey.attraction.gy-a1.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guiyang's riverside landmark glowing beautifully at night."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El emblemático pabellón junto al río, precioso cuando se ilumina de noche."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O famoso pavilhão à beira do rio, especialmente bonito iluminado à noite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знаменитый павильон у реки, особенно красивый в ночной подсветке."
          }
        }
      }
    },
    "journey.attraction.gy-a1.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Built in 1598 on a rocky outcrop above the Nanming River, this triple-eaved pavilion is Guiyang's symbol. Red lanterns and golden reflections ripple across the water after dark."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construido en 1598 sobre una roca junto al río Nanming, este pabellón de tres niveles es el símbolo de Guiyang. Farolillos rojos y reflejos dorados brillan en el agua al anochecer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construído em 1598 sobre uma rocha às margens do rio Nanming, este pavilhão de três andares é o símbolo de Guiyang. Lanternas vermelhas e reflexos dourados dançam na água depois do anoitecer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Построенный в 1598 году на скале над рекой Наньмин, трёхъярусный павильон — символ Гуйяна. После заката красные фонари и золотые блики пляшут на воде."
          }
        }
      }
    },
    "journey.attraction.gy-a1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jiaxiu Pavilion"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pabellón Jiaxiu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pavilhão Jiaxiu"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Павильон Цзясю"
          }
        }
      }
    },
    "journey.attraction.gy-a1.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cross the stone arch bridge at dusk when the pavilion lights switch on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cruza el puente de piedra al atardecer, cuando encienden las luces del pabellón."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe pela ponte de pedra ao pôr do sol, quando as luzes do pavilhão acendem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переходите каменный арочный мост на закате, когда включают подсветку павильона."
          }
        }
      }
    },
    "journey.attraction.gy-a2.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forested hills, temples, lake views, and playful macaques."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colinas boscosas, templos, vistas al lago y macacos juguetones."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colinas arborizadas, templos, vista para o lago e macacos brincalhões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лесистые холмы, храмы, виды на озеро и озорные макаки."
          }
        }
      }
    },
    "journey.attraction.gy-a2.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qianling Park wraps a forested hill with winding trails, a serene lake, and the ancient Hongfu Temple. Wild macaques roam freely — they are bold but harmless if you keep snacks hidden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El parque rodea una colina boscosa con senderos, un lago tranquilo y el antiguo templo Hongfu. Macacos salvajes merodean libremente: son atrevidos pero inofensivos si ocultas la comida."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O parque contorna uma colina arborizada com trilhas sinuosas, um lago tranquilo e o antigo templo Hongfu. Macacos selvagens circulam livremente — são ousados, mas inofensivos se você esconde os petiscos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Парк опоясывает лесистый холм с извилистыми тропами, тихим озером и древним храмом Хунфу. Здесь свободно живут макаки — они смелые, но безобидные, если спрятать еду."
          }
        }
      }
    },
    "journey.attraction.gy-a2.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qianling Hill Park"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parque de la Colina Qianling"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parque da Colina Qianling"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Парк горы Цяньлин"
          }
        }
      }
    },
    "journey.attraction.gy-a2.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep food in your bag — the macaques will spot an open snack instantly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda la comida en la bolsa: los macacos detectan un bocadillo al instante."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde a comida na bolsa — os macacos detectam um petisco aberto num instante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите еду в сумке — макаки мгновенно заметят открытую закуску."
          }
        }
      }
    },
    "journey.attraction.gy-a3.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stone lanes and historic architecture from the Ming era."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Callejuelas de piedra y arquitectura histórica de la época Ming."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruelas de pedra e arquitetura histórica da era Ming."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каменные улочки и историческая архитектура эпохи Мин."
          }
        }
      }
    },
    "journey.attraction.gy-a3.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This 600-year-old fortress town south of Guiyang keeps Ming-era stone walls, narrow lanes, and courtyard homes. Local snacks like rose candy and tofu pudding fill the market stalls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al sur de Guiyang, esta ciudad fortificada de 600 años conserva murallas Ming, callejuelas estrechas y casas con patios. Los puestos venden caramelos de rosa y tofu dulce."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao sul de Guiyang, esta cidade fortificada de 600 anos mantém muralhas Ming, becos estreitos e casas com pátios. Barracas vendem doces de rosa e tofu doce."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "К югу от Гуйяна этот 600-летний крепостной город сохранил каменные стены эпохи Мин, узкие улочки и дома с двориками. На рынках — розовые конфеты и тофу-пудинг."
          }
        }
      }
    },
    "journey.attraction.gy-a3.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qingyan Ancient Town"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciudad antigua de Qingyan"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cidade antiga de Qingyan"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Древний город Цинъянь"
          }
        }
      }
    },
    "journey.attraction.gy-a3.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wear comfortable shoes — the stone lanes are steep and slippery when wet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva calzado cómodo: las calles de piedra son empinadas y resbaladizas con lluvia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use calçado confortável — as ruas de pedra são íngremes e escorregadias quando molhadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наденьте удобную обувь — каменные улочки крутые и скользкие в дождь."
          }
        }
      }
    },
    "journey.attraction.gy-a4.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A peaceful green corridor of rivers, fields, and walking paths."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tranquilo corredor verde de ríos, campos y senderos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um tranquilo corredor verde de rios, campos e trilhas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спокойный зелёный маршрут среди рек, полей и прогулочных дорожек."
          }
        }
      }
    },
    "journey.attraction.gy-a4.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huaxi National Urban Wetland Park threads rivers, lotus ponds, and rice fields through the city's southern edge. Boardwalks and cycling paths make it a favorite morning escape for locals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El parque urbano Huaxi entrelaza ríos, estanques de lotos y arrozales en el sur de la ciudad. Pasarelas y rutas ciclistas lo convierten en escape matutino favorito de los locales."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O parque urbano Huaxi entrelaça rios, lagoas de lotus e arrozais na borda sul da cidade. Passarelas e ciclovias fazem dele o escape matinal favorito dos moradores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Национальный городской парк Хуаси протягивает реки, пруды с лотосами и рисовые поля по южной окраине города. Настилы и велодорожки — любимое место для утренних прогулок."
          }
        }
      }
    },
    "journey.attraction.gy-a4.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huaxi Wetland"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Humedal de Huaxi"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Área úmida de Huaxi"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Водно-болотный парк Хуаси"
          }
        }
      }
    },
    "journey.attraction.gy-a4.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visit early morning for mist over the fields and fewer cyclists."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visita temprano por la mañana: niebla sobre los campos y menos ciclistas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visite no início da manhã para névoa sobre os campos e menos ciclistas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приезжайте рано утром — над полями туман и меньше велосипедистов."
          }
        }
      }
    },
    "journey.attraction.gy-a5.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guizhou's ethnic cultures, fossils, and ancient bronze drums."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Culturas étnicas de Guizhou, fósiles y antiguos tambores de bronce."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Culturas étnicas de Guizhou, fósseis e antigos tambores de bronze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Культуры народов Гуйчжоу, окаменелости и древние бронзовые барабаны."
          }
        }
      }
    },
    "journey.attraction.gy-a5.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The museum's striking modern building houses exhibits on Miao, Dong, and Bouyei minority cultures alongside prehistoric fossils and bronze drum collections. Free entry makes it an easy half-day visit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El moderno edificio alberga exposiciones de culturas miao, dong y bouyei, fósiles prehistóricos y tambores de bronce. Entrada gratuita: visita fácil de medio día."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O moderno prédio abriga exposições das culturas miao, dong e bouyei, fósseis pré-históricos e tambores de bronze. Entrada gratuita — visita fácil de meio dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В современном здании музея — экспозиции о культурах народов мяо, дун и буи, доисторические окаменелости и коллекция бронзовых барабанов. Вход бесплатный — лёгкая прогулка на полдня."
          }
        }
      }
    },
    "journey.attraction.gy-a5.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guizhou Provincial Museum"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Museo Provincial de Guizhou"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Museu Provincial de Guizhou"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Провинциальный музей Гуйчжоу"
          }
        }
      }
    },
    "journey.attraction.gy-a5.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start on the top floor for the ethnic costume gallery — it's the highlight."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza en el piso superior: la galería de trajes étnicos es lo mejor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece no andar superior — a galeria de trajes étnicos é o destaque."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните с верхнего этажа — галерея национальных костюмов — главная находка."
          }
        }
      }
    },
    "journey.attraction.gz-a1.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A colorful landmark with panoramic views over the Pearl River."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un colorido símbolo con vistas panorámicas al río de las Perlas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um marco colorido com vista panorâmica para o Rio das Pérolas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Яркая достопримечательность с панорамным видом на Жемчужную реку."
          }
        }
      }
    },
    "journey.attraction.gz-a1.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At 600 meters, Canton Tower is one of the world's tallest towers. Its twisted hyperboloid shape lights up in rainbow colors at night, and the bubble tram on the observation deck rotates slowly above the Pearl River."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con 600 metros, la Torre de Cantón es una de las más altas del mundo. Su forma hiperboloide retorcida se ilumina en arcoíris de noche, y el tranvía burbuja en la plataforma gira lentamente sobre el río de las Perlas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com 600 metros, a Torre de Cantão é uma das mais altas do mundo. Sua forma hiperboloide torcida se ilumina em arco-íris à noite, e o bonde bolha no mirante gira lentamente sobre o Rio das Pérolas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Высота 600 метров — Кантонская башня одна из самых высоких в мире. Скрученный гиперболоид ночью светится радугой, а пузырьковый вагончик на смотровой медленно вращается над Жемчужной рекой."
          }
        }
      }
    },
    "journey.attraction.gz-a1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canton Tower"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torre de Cantón"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torre de Cantão"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кантонская башня"
          }
        }
      }
    },
    "journey.attraction.gz-a1.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ride the bubble tram at dusk — the city lights switch on as the cabin climbs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube al tranvía burbuja al atardecer: las luces se encienden mientras asciende la cabina."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pegue o bonde bolha ao pôr do sol — as luzes acendem enquanto a cabine sobe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокатитесь на пузырьковом вагончике на закате — огни зажигаются во время подъёма."
          }
        }
      }
    },
    "journey.attraction.gz-a2.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An ornate masterpiece of traditional Lingnan craftsmanship."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una obra maestra ornamentada de la artesanía tradicional de Lingnan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma obra-prima ornamentada do artesanato tradicional de Lingnan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Богато украшенный шедевр традиционного мастерства Линнаня."
          }
        }
      }
    },
    "journey.attraction.gz-a2.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Built in 1894 as a clan academy, this complex showcases exquisite wood, stone, and ceramic carvings across 19 halls. Every beam and bracket tells a story — dragons, flowers, and historical scenes in miniature detail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construida en 1894 como academia del clan, el complejo exhibe tallas exquisitas en madera, piedra y cerámica en 19 salones. Cada viga cuenta una historia: dragones, flores y escenas históricas en miniatura."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construída em 1894 como academia do clã, o complexo exibe entalhes requintados em madeira, pedra e cerâmica em 19 salões. Cada viga conta uma história — dragões, flores e cenas históricas em miniatura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Построенная в 1894 году как академия рода, комплекс демонстрирует изящную резьбу по дереву, камню и керамике в 19 залах. На каждой балке — драконы, цветы и исторические сцены в мельчайших деталях."
          }
        }
      }
    },
    "journey.attraction.gz-a2.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chen Clan Ancestral Hall"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salón Ancestral del Clan Chen"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salão Ancestral do Clã Chen"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Академия рода Чэнь"
          }
        }
      }
    },
    "journey.attraction.gz-a2.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow at least 90 minutes — the roof carvings alone deserve slow attention."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reserva al menos 90 minutos: las tallas del techo merecen atención pausada."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reserve pelo menos 90 minutos — os entalhes do telhado merecem atenção lenta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выделите минимум 90 минут — резьба на крышах сама по себе того стоит."
          }
        }
      }
    },
    "journey.attraction.gz-a3.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leafy streets lined with historic European-style buildings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calles arboladas con edificios históricos de estilo europeo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruas arborizadas com edifícios históricos em estilo europeu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тенистые улицы с историческими зданиями в европейском стиле."
          }
        }
      }
    },
    "journey.attraction.gz-a3.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This sandbank island was a foreign concession in the 19th century, and its colonial villas, churches, and tree-lined avenues feel like a slice of Europe in the Pearl River Delta. Cafés and sculpture gardens fill the quiet streets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta isla de arena fue concesión extranjera en el siglo XIX: villas coloniales, iglesias y avenidas arboladas parecen un trozo de Europa en el delta del río de las Perlas. Cafés y jardines de esculturas llenan las calles tranquilas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta ilha de areia foi concessão estrangeira no século XIX — vilas coloniais, igrejas e avenidas arborizadas parecem um pedaço de Europa no delta do Rio das Pérolas. Cafés e jardins de esculturas lotam as ruas tranquilas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот песчаный остров был иностранной концессией в XIX веке — колониальные виллы, церкви и аллеи с деревьями напоминают кусочек Европы в дельте Жемчужной реки. Кафе и скульптурные сады заполняют тихие улочки."
          }
        }
      }
    },
    "journey.attraction.gz-a3.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shamian Island"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isla Shamian"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilha Shamian"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остров Шамянь"
          }
        }
      }
    },
    "journey.attraction.gz-a3.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walk the island on a weekday morning — weekends bring wedding photo crews to every corner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorre la isla un día laborable por la mañana: los fines de semana hay fotógrafos de bodas en cada rincón."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caminhe na ilha em dia de semana de manhã — nos fins de semana há fotógrafos de casamento em cada esquina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гуляйте в будни утром — в выходные на каждом углу свадебные фотосессии."
          }
        }
      }
    },
    "journey.attraction.gz-a4.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Green trails and sweeping views above the city."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senderos verdes y amplias vistas sobre la ciudad."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trilhas verdes e amplas vistas da cidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зелёные тропы и широкие панорамы города."
          }
        }
      }
    },
    "journey.attraction.gz-a4.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baiyun Mountain rises 382 meters above Guangzhou, offering forest trails, waterfalls, and a cable car to the summit. On clear days the view stretches across the entire Pearl River Delta megacity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baiyun se eleva 382 metros sobre Cantón con senderos forestales, cascadas y teleférico a la cima. En días claros la vista abarca toda la megaciudad del delta del río de las Perlas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baiyun se eleva 382 metros sobre Guangzhou com trilhas na floresta, cachoeiras e teleférico até o topo. Em dias claros a vista alcança toda a megacidade do delta do Rio das Pérolas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Байюнь поднимается 382 метра над Гуанчжоу — лесные тропы, водопады и канатная дорога на вершину. В ясный день вид уходит на весь мегаполис дельты Жемчужной реки."
          }
        }
      }
    },
    "journey.attraction.gz-a4.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baiyun Mountain"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montaña Baiyun"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montanha Baiyun"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гора Байюнь"
          }
        }
      }
    },
    "journey.attraction.gz-a4.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take the cable car up and walk down — the descent through the forest takes about an hour."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube en teleférico y baja caminando: el descenso por el bosque lleva una hora."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suba no teleférico e desça a pé — a descida pela floresta leva cerca de uma hora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поднимитесь на канатной дороге и спуститесь пешком — спуск через лес около часа."
          }
        }
      }
    },
    "journey.attraction.gz-a5.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangzhou's glittering CBD along the Pearl River."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El brillante CBD de Cantón junto al río de las Perlas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O brilhante CBD de Guangzhou às margens do Rio das Pérolas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сияющий деловой центр Гуанчжоу вдоль Жемчужной реки."
          }
        }
      }
    },
    "journey.attraction.gz-a5.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zhujiang New Town clusters Guangzhou's tallest towers, the Opera House, and the Library around a central axis. The evening light show on the riverfront buildings rivals any skyline spectacle in China."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zhujiang New Town concentra las torres más altas de Cantón, la Ópera y la Biblioteca en torno a un eje central. El show de luces nocturno en los edificios del paseo marítimo rivaliza con cualquier espectáculo urbano de China."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zhujiang New Town concentra as torres mais altas de Guangzhou, a Ópera e a Biblioteca em torno de um eixo central. O show de luzes noturno nos prédios da orla rivaliza com qualquer espetáculo urbano da China."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новый город Чжуцзян собирает самые высокие башни Гуанчжоу, оперный театр и библиотеку вокруг центральной оси. Вечернее световое шоу на набережных не уступает любому в Китае."
          }
        }
      }
    },
    "journey.attraction.gz-a5.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zhujiang New Town"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nueva Ciudad Zhujiang"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nova Cidade Zhujiang"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новый город Чжуцзян"
          }
        }
      }
    },
    "journey.attraction.gz-a5.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch the light show from Haixinsha Island — the view across the river is unobstructed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve el show de luces desde la isla Haixinsha: la vista al otro lado del río es despejada."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja o show de luzes da ilha Haixinsha — a vista do outro lado do rio é desimpedida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрите световое шоу с острова Хайсинша — вид через реку без помех."
          }
        }
      }
    },
    "journey.attraction.hb-a1.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Massive illuminated ice sculptures at night."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enormes esculturas de hielo iluminadas por la noche."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enormes esculturas de gelo iluminadas à noite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Огромные ледяные скульптуры, подсвеченные ночью."
          }
        }
      }
    },
    "journey.attraction.hb-a1.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every January, Harbin Ice and Snow World builds a frozen city of palaces, towers, and slides from blocks of river ice. Millions of LED lights turn the sculptures into a glowing fantasyland that lasts until March."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada enero, el Mundo de Hielo y Nieve de Harbin construye una ciudad helada de palacios, torres y toboganes con bloques de hielo de río. Millones de LED convierten las esculturas en un mundo de fantasía luminoso hasta marzo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo janeiro, o Mundo de Gelo e Neve de Harbin constrói uma cidade congelada de palácios, torres e escorregadores com blocos de gelo de rio. Milhões de LEDs transformam as esculturas em um mundo de fantasia luminoso até março."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый январь в Ледовом и снежном мире Харбина из речного льда строят замки, башни и горки. Миллионы светодиодов превращают скульптуры в светящийся фантастический город, который живёт до марта."
          }
        }
      }
    },
    "journey.attraction.hb-a1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ice Festival"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Festival del Hielo"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Festival do Gelo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ледовый фестиваль"
          }
        }
      }
    },
    "journey.attraction.hb-a1.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dress in layers and rent padded boots on site — temperatures drop below −20°C at night."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viste en capas y alquila botas acolchadas allí: de noche baja de −20 °C."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vista-se em camadas e alugue botas forradas no local — à noite cai abaixo de −20 °C."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одевайтесь слоями и арендуйте утеплённые ботинки на месте — ночью ниже −20 °C."
          }
        }
      }
    },
    "journey.attraction.hb-a2.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historic cobblestone boulevard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Histórico bulevar adoquinado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Histórico boulevard de paralelepípedos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исторический бульвар, мощённый камнем."
          }
        }
      }
    },
    "journey.attraction.hb-a2.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Built in 1898, Central Street stretches 1.4 km of cobblestones lined with Baroque and Renaissance facades. Russian bakeries, European delis, and ice-cream shops make it Harbin's most atmospheric walk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construida en 1898, la Calle Central recorre 1,4 km de adoquines con fachadas barrocas y renacentistas. Panaderías rusas, delicatessen europeas y heladerías: el paseo más atmosférico de Harbin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construída em 1898, a Rua Central percorre 1,4 km de paralelepípedos com fachadas barrocas e renascentistas. Padarias russas, delicatessen europeas e sorveterias — o passeio mais atmosférico de Harbin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Построенная в 1898 году, Центральная улица — 1,4 км брусчатки с фасадами в стиле барокко и ренессанса. Русские булочные, европейские деликатесы и мороженое — самая атмосферная прогулка Харбина."
          }
        }
      }
    },
    "journey.attraction.hb-a2.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Central Street"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calle Central"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rua Central"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Центральная улица"
          }
        }
      }
    },
    "journey.attraction.hb-a2.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try the original Harbin sausage and Ma Die'er bread from the century-old shops."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba la salchicha original de Harbin y el pan Ma Die'er de las tiendas centenarias."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prove a salsicha original de Harbin e o pão Ma Die'er das lojas centenárias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попробуйте фирменную харбинскую колбасу и хлеб Ма Диеэр из столетних лавок."
          }
        }
      }
    },
    "journey.attraction.hb-a3.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byzantine-style cathedral turned museum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catedral de estilo bizantino convertida en museo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catedral em estilo bizantino transformada em museu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Собор в византийском стиле, превращённый в музей."
          }
        }
      }
    },
    "journey.attraction.hb-a3.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Built in 1907, Saint Sophia Cathedral is the largest Byzantine-style church in the Far East. Its green dome and red brick walls now house a museum of Harbin's Russian architectural heritage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construida en 1907, la catedral de Santa Sofía es la iglesia bizantina más grande del Lejano Oriente. Su cúpula verde y muros de ladrillo rojo albergan hoy un museo de la arquitectura rusa de Harbin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construída em 1907, a catedral de Santa Sofia é a maior igreja bizantina do Extremo Oriente. Sua cúpula verde e paredes de tijolo vermelho abrigam hoje um museu da arquitetura russa de Harbin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Построенный в 1907 году, собор Святой Софии — крупнейший византийский храм на Дальнем Востоке. Зелёный купол и красные кирпичные стены теперь — музей русской архитектуры Харбина."
          }
        }
      }
    },
    "journey.attraction.hb-a3.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saint Sophia"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Santa Sofía"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Santa Sofia"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Собор Святой Софии"
          }
        }
      }
    },
    "journey.attraction.hb-a3.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photograph the cathedral from the square at night when floodlights highlight the dome."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografía la catedral desde la plaza de noche, cuando los focos resaltan la cúpula."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografe a catedral da praça à noite, quando os refletores destacam a cúpula."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фотографируйте собор с площади ночью — прожекторы подсвечивают купол."
          }
        }
      }
    },
    "journey.attraction.hb-a4.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fantasy snow castles and slides."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fantásticos castillos de nieve y toboganes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fantásticos castelos de neve e escorregadores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сказочные снежные замки и горки."
          }
        }
      }
    },
    "journey.attraction.hb-a4.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harbin Snow World rivals the Ice Festival with massive snow sculptures and illuminated snow buildings. Giant snow slides and castle replicas draw families during the day, while colored lights transform the park at night."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Mundo de Nieve de Harbin rivaliza con el Festival del Hielo con enormes esculturas y edificios de nieve iluminados. Toboganes gigantes y réplicas de castillos atraen familias de día; luces de colores transforman el parque de noche."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mundo da Neve de Harbin rivaliza com o Festival do Gelo com enormes esculturas e construções de neve iluminadas. Escorregadores gigantes e réplicas de castelos atraem famílias de dia; luzes coloridas transformam o parque à noite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снежный мир Харбина соперничает с Ледовым фестивалем: гигантские снежные скульптуры и подсвечённые снежные постройки. Большие горки и копии замков — для семей днём, цветные огни — ночью."
          }
        }
      }
    },
    "journey.attraction.hb-a4.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snow World"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mundo de Nieve"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mundo da Neve"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мир снега"
          }
        }
      }
    },
    "journey.attraction.hb-a4.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visit both Snow World and Ice Festival on separate evenings — each park takes two to three hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visita el Mundo de Nieve y el Festival del Hielo en noches distintas: cada parque lleva dos o tres horas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visite o Mundo da Neve e o Festival do Gelo em noites diferentes — cada parque leva duas ou três horas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посетите Снежный мир и Ледовой фестиваль в разные вечера — каждый парк занимает два-три часа."
          }
        }
      }
    },
    "journey.attraction.hb-a5.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Striking modern opera house on the Songhua River."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impactante ópera moderna junto al río Songhua."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impactante ópera moderna às margens do rio Songhua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эффектный современный оперный театр на реке Сунгари."
          }
        }
      }
    },
    "journey.attraction.hb-a5.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Designed by MAD Architects, the Harbin Opera House curves like frozen waves beside the Songhua River. The white granite exterior and warm wood interior host opera, ballet, and symphony performances year-round."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diseñada por MAD Architects, la Ópera de Harbin se curva junto al río Songhua como olas congeladas. Granito blanco por fuera y madera cálida por dentro acogen ópera, ballet y sinfonías todo el año."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenhada por MAD Architects, a Ópera de Harbin se curva junto ao rio Songhua como ondas congeladas. Granito branco por fora e madeira quente por dentro abrigam ópera, balé e sinfonias o ano inteiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спроектированный MAD Architects, Харбинский оперный театр изгибается у реки Сунгари, как застывшие волны. Белый гранит снаружи и тёплое дерево внутри — опера, балет и симфонии круглый год."
          }
        }
      }
    },
    "journey.attraction.hb-a5.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
