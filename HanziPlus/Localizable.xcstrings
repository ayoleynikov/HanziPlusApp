    "path.course.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live dialogues, new words, and a quiz in every lesson. The course builds gradually: from greetings and simple phrases to everyday situations and more complex structures."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diálogos reales, palabras nuevas y una prueba en cada lección. El curso avanza gradualmente: de saludos y frases simples a situaciones cotidianas y estructuras más complejas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diálogos reais, palavras novas e um teste em cada lição. O curso avança gradualmente: de cumprimentos e frases simples a situações do dia a dia e estruturas mais complexas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Живые диалоги, новые слова и проверка в каждом уроке. Курс выстроен по нарастающей: от приветствий и простых фраз к повседневным ситуациям и более сложным конструкциям."
          }
        }
